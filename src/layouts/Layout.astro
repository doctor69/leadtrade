---
import { ThemeProvider } from "@/components/ThemeProvider";
import MetaTags from "@/components/MetaTags.astro";
import "../styles/global.css";
import NavigationBar from "@/components/ui/navbar";

export interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
	type?: 'website' | 'article';
	siteName?: string;
	twitterCard?: 'summary' | 'summary_large_image';
	twitterSite?: string;
	twitterCreator?: string;
	keywords?: string;
	author?: string;
	preloadResources?: string[];
	showNavigation?: boolean;
}

const { 
	title = "LEADTRADE - Trading Platform for Leaders",
	description = "The ultimate trading platform with real market data and follow trading features",
	image,
	url,
	type,
	siteName,
	twitterCard,
	twitterSite,
	twitterCreator,
	keywords,
	author,
	preloadResources = [],
	showNavigation = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- CRITICAL: Immediate cache clearing for Chrome -->
		<script is:inline>
			// Run immediately before anything else loads
			(function() {
				if ('serviceWorker' in navigator) {
					navigator.serviceWorker.getRegistrations().then(function(registrations) {
						registrations.forEach(function(registration) {
							registration.unregister();
						});
					});
				}
				if ('caches' in window) {
					caches.keys().then(function(names) {
						names.forEach(function(name) {
							caches.delete(name);
						});
					});
				}
			})();
		</script>
		
		<!-- Dynamic Meta Tags -->
		<MetaTags 
			title={title}
			description={description}
			image={image}
			url={url}
			type={type}
			siteName={siteName}
			twitterCard={twitterCard}
			twitterSite={twitterSite}
			twitterCreator={twitterCreator}
			keywords={keywords}
			author={author}
		/>
		
		<!-- PWA Manifest -->
		<link rel="manifest" href="/manifest.json" />
		
		<!-- App Icons -->
		<link rel="icon" type="image/svg+xml" sizes="any" href="/icons/icon-512x512.svg" />
		<link rel="apple-touch-icon" href="/icons/icon-192x192.svg" />
		<link rel="apple-touch-icon" sizes="152x152" href="/icons/icon-152x152.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192x192.svg" />
		<link rel="apple-touch-icon" sizes="167x167" href="/icons/icon-152x152.svg" />
		
		<!-- Apple Mobile Web App Capable -->
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="LEADTRADE" />
		
		<!-- Mobile Theme Colors -->
		<meta name="theme-color" content="#3b82f6" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#1e40af" media="(prefers-color-scheme: dark)" />
		<meta name="msapplication-TileColor" content="#3b82f6" />
		<meta name="msapplication-config" content="/browserconfig.xml" />
		

		
		<!-- Preload critical resources -->
		{preloadResources.map(resource => (
			<link rel="preload" href={resource} as={
				resource.endsWith('.css') ? 'style' :
				resource.endsWith('.js') ? 'script' :
				resource.match(/\.(png|jpg|jpeg|gif|svg|webp)$/) ? 'image' :
				'fetch'
			} />
		))}
		
		<!-- DNS prefetch for external resources -->
		<link rel="dns-prefetch" href="//fonts.googleapis.com" />
		<link rel="dns-prefetch" href="//api.alpaca.markets" />

		<!-- Inter font — preconnect then load -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" />
		
		<!-- Critical CSS inlined by Astro -->
		<style>
			/* Critical above-the-fold styles */
			body { 
				font-family: system-ui, -apple-system, sans-serif;
				line-height: 1.6;
			}
			.container { 
				max-width: 1200px; 
				margin: 0 auto; 
				padding: 0 1rem; 
			}
			
			/* Mobile-specific styles */
			@media (max-width: 768px) {
				.container {
					padding: 0 0.5rem;
				}
			}
			
			/* Safe area for mobile devices */
			@supports (padding: max(0px)) {
				body {
					padding-left: max(1rem, env(safe-area-inset-left));
					padding-right: max(1rem, env(safe-area-inset-right));
					padding-bottom: max(1rem, env(safe-area-inset-bottom));
				}
			}
		</style>
		
		<script is:inline>
			// Enhanced theme initialization - prevents flash of wrong theme
			// Uses cookie-based persistence for immediate loading
			(function() {
				// Cookie utility functions
				function getCookie(name) {
					try {
						const nameEQ = name + "=";
						const ca = document.cookie.split(';');
						for (let i = 0; i < ca.length; i++) {
							let c = ca[i];
							while (c.charAt(0) === ' ') c = c.substring(1, c.length);
							if (c.indexOf(nameEQ) === 0) {
								return decodeURIComponent(c.substring(nameEQ.length, c.length));
							}
						}
					} catch (error) {
						console.warn('Failed to get cookie:', error);
					}
					return null;
				}

				function isValidTheme(theme) {
					return ['light', 'dark', 'system'].includes(theme);
				}

				function isValidHexColor(color) {
					return /^#[0-9A-F]{6}$/i.test(color);
				}

				function getSystemTheme() {
					try {
						return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					} catch (error) {
						return 'light';
					}
				}

				function applyTheme(theme) {
					try {
						const root = document.documentElement;
						root.classList.remove('light', 'dark');
						
						if (theme === 'system') {
							const systemTheme = getSystemTheme();
							root.classList.add(systemTheme);
						} else {
							root.classList.add(theme);
						}
						
						// Verify theme was applied
						const hasTheme = root.classList.contains('light') || root.classList.contains('dark');
						return hasTheme;
					} catch (error) {
						console.warn('Failed to apply theme:', error);
						return false;
					}
				}

				function hexToHsl(hex) {
					try {
						const r = parseInt(hex.slice(1, 3), 16) / 255;
						const g = parseInt(hex.slice(3, 5), 16) / 255;
						const b = parseInt(hex.slice(5, 7), 16) / 255;

						const max = Math.max(r, g, b);
						const min = Math.min(r, g, b);
						let h = 0;
						let s = 0;
						const l = (max + min) / 2;

						if (max !== min) {
							const d = max - min;
							s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
							switch (max) {
								case r: h = (g - b) / d + (g < b ? 6 : 0); break;
								case g: h = (b - r) / d + 2; break;
								case b: h = (r - g) / d + 4; break;
							}
							h /= 6;
						}

						return Math.round(h * 360) + ' ' + Math.round(s * 100) + '% ' + Math.round(l * 100) + '%';
					} catch (error) {
						return '0 0% 50%'; // Fallback gray
					}
				}

				function applyThemeColor(color) {
					try {
						if (!isValidHexColor(color)) {
							color = '#ef4444'; // Default color
						}

						const root = document.documentElement;
						const hslColor = hexToHsl(color);
						const parts = hslColor.split(' ');
						const h = parseFloat(parts[0]);
						const s = parseFloat(parts[1]);
						const l = parseFloat(parts[2]);
						
						// Set primary color
						root.style.setProperty('--primary', hslColor);
						root.style.setProperty('--ring', hslColor);
						
						// Set accent color
						const accentL = Math.min(l + 40, 95);
						const accentS = Math.max(s - 20, 10);
						root.style.setProperty('--accent', h + ' ' + accentS + '% ' + accentL + '%');
					} catch (error) {
						console.warn('Failed to apply theme color:', error);
					}
				}

				// Load and apply theme with fallback
				function loadThemeWithFallback() {
					let theme = getCookie('leadtrade-theme');
					
					// Try localStorage fallback if cookie fails
					if (!theme || !isValidTheme(theme)) {
						try {
							theme = localStorage.getItem('leadtrade-theme-fallback');
						} catch (e) {
							console.warn('localStorage fallback failed:', e);
						}
					}
					
					// Final fallback to default
					if (!theme || !isValidTheme(theme)) {
						theme = 'light';
					}
					
					return theme;
				}

				function loadThemeColorWithFallback() {
					let color = getCookie('leadtrade-theme-color');
					
					// Try localStorage fallback if cookie fails
					if (!color || !isValidHexColor(color)) {
						try {
							color = localStorage.getItem('leadtrade-theme-color-fallback');
						} catch (e) {
							console.warn('localStorage fallback failed:', e);
						}
					}
					
					// Final fallback to default
					if (!color || !isValidHexColor(color)) {
						color = '#ef4444';
					}
					
					return color;
				}

				// Apply theme with error recovery
				let appliedTheme = 'light';
				try {
					appliedTheme = loadThemeWithFallback();
					console.log('[Theme Init] Loaded theme:', appliedTheme);
					const success = applyTheme(appliedTheme);
					console.log('[Theme Init] Applied theme successfully:', success);
					console.log('[Theme Init] Document classes:', document.documentElement.className);
					
					if (!success) {
						console.warn('Theme application failed, using emergency fallback');
						document.documentElement.classList.add('light');
						appliedTheme = 'light';
					}
				} catch (error) {
					console.error('Critical theme error:', error);
					document.documentElement.classList.add('light');
					appliedTheme = 'light';
				}

				// Apply theme color with error recovery
				try {
					const themeColor = loadThemeColorWithFallback();
					applyThemeColor(themeColor);
				} catch (error) {
					console.warn('Theme color application failed:', error);
					// Continue without custom colors
				}

				// Listen for system theme changes if using system theme
				if (appliedTheme === 'system') {
					try {
						const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
						mediaQuery.addEventListener('change', function() {
							applyTheme('system');
						});
					} catch (error) {
						console.warn('Failed to listen for system theme changes:', error);
					}
				}
			})();
		</script>
		
		<!-- Initialize performance monitoring -->
		<script is:inline>
			// Early performance tracking
			window.__LEADTRADE_PERF_START = Date.now();
			
			// Track resource loading
			if ('PerformanceObserver' in window) {
				const observer = new PerformanceObserver((list) => {
					// Store performance entries for later analysis
					window.__LEADTRADE_PERF_ENTRIES = window.__LEADTRADE_PERF_ENTRIES || [];
					window.__LEADTRADE_PERF_ENTRIES.push(...list.getEntries());
				});
				observer.observe({ entryTypes: ['navigation', 'resource', 'paint'] });
			}
			
			// PWA installation prompt
			window.addEventListener('beforeinstallprompt', (e) => {
				e.preventDefault();
				// Store the event for later use
				window.deferredPrompt = e;
				console.log('PWA install prompt available');
			});
			
			// TEMPORARILY DISABLED: Service worker causing deployment cache issues
			// Unregister existing service workers to clear cache
			if ('serviceWorker' in navigator) {
				navigator.serviceWorker.getRegistrations().then((registrations) => {
					for (const registration of registrations) {
						registration.unregister();
						console.log('Unregistered service worker:', registration);
					}
				});
				
				// Clear all caches
				if ('caches' in window) {
					caches.keys().then((cacheNames) => {
						cacheNames.forEach((cacheName) => {
							caches.delete(cacheName);
							console.log('Deleted cache:', cacheName);
						});
					});
				}
			}
			
			// Suppress React key warnings during Astro hydration
			try {
				const originalConsoleError = console.error;
				console.error = function(...args) {
					const message = args[0];
					if (typeof message === 'string' && message.includes('Each child in a list should have a unique "key" prop')) {
						// Suppress React key warnings from Astro hydration
						return;
					}
					originalConsoleError.apply(console, args);
				};
			} catch (error) {
				console.warn('Failed to suppress React key warnings:', error);
			}
		</script>
		
		<!-- Initialize logger with trading mode -->
		<script>
			import { logger } from '@/lib/logger';
			import { getAppTradingMode } from '@/lib/trading-config';
			
			// Initialize logger when DOM is ready
			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', async () => {
					const mode = await getAppTradingMode();
					logger.initLogger(mode);
				});
			} else {
				getAppTradingMode().then((mode: 'paper' | 'live') => {
					logger.initLogger(mode);
				});
			}
		</script>
	</head>
	<body class="min-h-screen bg-background text-foreground antialiased">
		<!-- ThemeProvider wraps all children -->
		<ThemeProvider client:load>
			{showNavigation && <NavigationBar client:load />}
			<main id="main-content" class="container mx-auto px-4 py-6">
				<slot />
			</main>
		</ThemeProvider>
	</body>
</html>
