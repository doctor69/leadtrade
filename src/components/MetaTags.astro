---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  type?: "website" | "article";
  siteName?: string;
  twitterCard?: "summary" | "summary_large_image";
  twitterSite?: string;
  twitterCreator?: string;
  keywords?: string;
  author?: string;
}

const {
  title = "LEADTRADE - Trading Platform for Leaders",
  description = "The ultimate trading platform with real market data and follow trading features",
  image = "/social/leadtrade-preview.png",
  url,
  type = "website",
  siteName = "LEADTRADE",
  twitterCard = "summary_large_image",
  twitterSite = "@leadtrade",
  twitterCreator = "@leadtrade",
  keywords = "trading, stock market, paper trading, copy trading, investment, finance, trading platform",
  author = "LEADTRADE Team",
} = Astro.props;

// Ensure image URL is absolute
const baseUrl = "https://leadtrade.app";
const imageUrl = image.startsWith("http")
  ? image
  : `${baseUrl}${image.startsWith("/") ? image : `/${image}`}`;
const canonicalUrl = url 
  ? (url.startsWith("http") ? url : `${baseUrl}${url.startsWith("/") ? url : `/${url}`}`)
  : baseUrl;
---

<!-- Basic Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Card -->
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}

<!-- Additional Social Media Meta Tags -->
<meta name="application-name" content={siteName} />
<meta name="mobile-web-app-capable" content="yes" />

<!-- WhatsApp / Telegram specific -->
<meta property="og:image:type" content="image/svg+xml" />
<meta property="og:image:secure_url" content={imageUrl} />

<!-- LinkedIn specific -->
<meta property="og:updated_time" content={new Date().toISOString()} />

<!-- Discord specific -->
<meta name="theme-color" content="#3b82f6" />

<!-- iMessage / Apple specific -->
<meta name="apple-mobile-web-app-title" content={siteName} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black-translucent"
/>

<!-- Additional Twitter tags for better previews -->
<meta name="twitter:domain" content="leadtrade.app" />
<meta name="twitter:label1" content="Platform" />
<meta name="twitter:data1" content="Trading & Investment" />
<meta name="twitter:label2" content="Features" />
<meta
  name="twitter:data2"
  content="Paper Trading, Copy Trading, Real-time Data"
/>
