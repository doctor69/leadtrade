---
import Layout from '../layouts/Layout.astro';
import ProtectedRoute from '@/components/ProtectedRoute';
---

<Layout title="API Integration Demo">
  <ProtectedRoute client:load>
    <main class="container mx-auto px-4 py-8">
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">LEADTRADE API Demo</h1>
        <p class="text-muted-foreground">
          Comprehensive demonstration of all API endpoints integrated with the UI components.
        </p>
      </div>
      
      <div id="api-demo-root"></div>
    </main>
  </ProtectedRoute>
</Layout>

<script>
  import ApiIntegrationDemo from '../components/trading/ApiIntegrationDemo.tsx';
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';

  const container = document.getElementById('api-demo-root');
  if (container) {
    const root = createRoot(container);
    root.render(createElement(ApiIntegrationDemo));
  }
</script>