---
import Layout from "../layouts/Layout.astro";
import ResetPasswordForm from "@/components/ResetPasswordForm";

const pageTitle = "Reset Password - LEADTRADE";
const pageDescription = "Create a new password for your LEADTRADE account";
const pageImage = "/social/default-thumbnail.svg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="website"
  showNavigation={true}
>
  <div class="flex items-center justify-center min-h-[60vh]">
    <ResetPasswordForm client:load />
  </div>
</Layout>
