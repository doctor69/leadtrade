---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell";
import ProtectedRoute from "@/components/ProtectedRoute";
import SettingsPageContent from "@/components/account/SettingsPageContent";

// Social media metadata for settings page
const pageTitle = "Account Settings - LEADTRADE";
const pageDescription = "Manage your LEADTRADE account settings, trading preferences, privacy controls, and customize your trading experience.";
const pageImage = "/social/default-thumbnail.svg";
const pageKeywords = "account settings, trading preferences, privacy settings, user profile, LEADTRADE settings";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  keywords={pageKeywords}
  type="website"
>
  <AppShell client:only="react">
    <ProtectedRoute client:load>
      <SettingsPageContent client:load />
    </ProtectedRoute>
  </AppShell>
</Layout>