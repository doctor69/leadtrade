---
import Layout from "../layouts/Layout.astro";
import ForgotPasswordForm from "@/components/ForgotPasswordForm";

const pageTitle = "Forgot Password - LEADTRADE";
const pageDescription = "Reset your LEADTRADE account password";
const pageImage = "/social/default-thumbnail.svg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="website"
  showNavigation={true}
>
  <div class="flex items-center justify-center min-h-[60vh]">
    <ForgotPasswordForm client:load />
  </div>
</Layout>
