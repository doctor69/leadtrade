---
// WebSocket Demo Page - Demonstrates real-time WebSocket integration
import Layout from '../layouts/Layout.astro';
---

<Layout title="WebSocket Demo - Real-time Trading Data">
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto space-y-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Real-time WebSocket Integration Demo
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Experience live market data and trade notifications powered by WebSocket connections
        </p>
      </div>

      <!-- WebSocket Status and Market Data -->
      <div id="websocket-demo-container" class="space-y-6">
        <!-- This will be populated by React components -->
      </div>
    </div>
  </main>

  <script>
    import { createRoot } from 'react-dom/client';
    import { createElement } from 'react';
    import RealTimeMarketData from '../components/trading/RealTimeMarketData';
    import TradeNotifications from '../components/trading/TradeNotifications';

    // Mount React components
    const container = document.getElementById('websocket-demo-container');
    if (container) {
      const root = createRoot(container);
      
      root.render(
        createElement('div', { className: 'space-y-6' }, [
          createElement('div', { key: 'market-data' }, [
            createElement(RealTimeMarketData)
          ]),
          createElement('div', { key: 'notifications' }, [
            createElement(TradeNotifications, { enabled: true })
          ])
        ])
      );
    }
  </script>
</Layout>