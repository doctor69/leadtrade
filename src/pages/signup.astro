---
import Layout from "../layouts/Layout.astro";
import AccountCreationForm from "@/components/ui/trade/AccountCreationForm";

// Social media metadata for sign up page
const pageTitle = "Create Account - LEADTRADE";
const pageDescription = "Join LEADTRADE and start paper trading with real market data. Create your free account and access advanced trading features.";
const pageImage = "/social/default-thumbnail.svg";
const pageKeywords = "create account, sign up, join LEADTRADE, trading account, paper trading registration, free trading account";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  keywords={pageKeywords}
  type="website"
  showNavigation={true}
>
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Join LEADTRADE</h1>
        <p class="text-muted-foreground">Create your account and start paper trading with real market data</p>
      </div>
      <AccountCreationForm client:load />
    </div>
  </div>
</Layout>
