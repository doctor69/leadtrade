---
import Layout from "../layouts/Layout.astro";
import AccountCreationForm from "@/components/ui/trade/AccountCreationForm";

const { cookies, redirect, url } = Astro;

const accessToken = cookies.get("sb-access-token");
const refreshToken = cookies.get("sb-refresh-token");

// Get return URL from query params
const returnUrl = url.searchParams.get("returnUrl") || "/dashboard";

if (accessToken && refreshToken) {
  return redirect(returnUrl);
}
---

<Layout>
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Join LEADTRADE</h1>
        <p class="text-muted-foreground">Create your account and start paper trading with real market data</p>
      </div>
      <AccountCreationForm client:load returnUrl={returnUrl} />
    </div>
  </div>
</Layout>
