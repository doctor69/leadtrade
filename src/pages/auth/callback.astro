---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Authenticating - LEADTRADE">
  <div class="flex items-center justify-center min-h-screen">
    <div class="text-center">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary mx-auto mb-4"></div>
      <h2 class="text-2xl font-bold mb-2">Completing sign-in...</h2>
      <p class="text-muted-foreground">Please wait while we set up your account.</p>
    </div>
  </div>
</Layout>

<script>
  // Handle OAuth callback on the client side
  async function handleOAuthCallback() {
    try {
      console.log('Handling OAuth callback...');
      
      // Import Supabase client
      const { supabase } = await import('@/lib/supabase');
      
      // Get the session from the URL hash
      const { data, error } = await supabase.auth.getSession();
      
      if (error) {
        console.error('OAuth callback error:', error);
        // Redirect to sign-in with error
        window.location.href = '/signin?error=' + encodeURIComponent(error.message);
        return;
      }

      if (data.session && data.session.user) {
        console.log('OAuth successful, user:', data.session.user.email);
        
        // Store tokens in localStorage
        localStorage.setItem('sb-access-token', data.session.access_token);
        localStorage.setItem('sb-refresh-token', data.session.refresh_token);
        localStorage.setItem('sb-token-expires-at', data.session.expires_at?.toString() || '');
        localStorage.setItem('sb-token-refreshed-at', Date.now().toString());

        // Trigger storage event to update navbar
        window.dispatchEvent(new Event('storage'));

        // Check if this is a new user (first time OAuth)
        const userCreatedAt = new Date(data.session.user.created_at);
        const lastSignInAt = new Date(data.session.user.last_sign_in_at || '');
        const isNewUser = Math.abs(userCreatedAt.getTime() - lastSignInAt.getTime()) < 5000; // Within 5 seconds
        
        if (isNewUser) {
          console.log('New Google user detected, creating Alpaca account...');
          
          // Store basic info for Google users - they'll need to complete KYC later
          try {
            console.log('Google OAuth user detected - storing basic info');
            
            // Mark user as needing KYC completion
            const { error: metadataError } = await supabase.auth.updateUser({
              data: {
                ...data.session.user.user_metadata,
                needs_kyc_completion: true,
                oauth_provider: 'google',
                signup_completed_at: new Date().toISOString()
              }
            });
            
            if (signupError) {
              console.error('Failed to create comprehensive account setup:', signupError);
            } else if (signupResult?.success) {
              console.log('Account setup completed for Google user:', signupResult.data?.user_id);
            } else {
              console.error('Account setup failed:', signupResult?.error);
            }
          } catch (setupError) {
            console.error('Error creating account setup for Google user:', setupError);
          }
        }

        // Get return URL from query params or default to dashboard
        const urlParams = new URLSearchParams(window.location.search);
        const returnUrl = urlParams.get('returnUrl') || '/dashboard';
        
        // Redirect to dashboard or specified return URL
        setTimeout(() => {
          window.location.href = returnUrl;
        }, 1000); // Small delay to show the loading state
        
      } else {
        console.log('No session found, redirecting to sign-in');
        window.location.href = '/signin';
      }
      
    } catch (error) {
      console.error('OAuth callback handling error:', error);
      window.location.href = '/signin?error=' + encodeURIComponent('Authentication failed');
    }
  }

  // Run the callback handler when the page loads
  document.addEventListener('DOMContentLoaded', handleOAuthCallback);
</script>