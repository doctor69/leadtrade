---
import Layout from "@/layouts/Layout.astro"
import AppShell from "@/components/AppShell"
import TradingDashboard from "@/components/trading/TradingDashboard"
import ProtectedRoute from "@/components/ProtectedRoute"
import PortfolioSummary from "@/components/dashboard/PortfolioSummary"
import AssetGrid from "@/components/dashboard/AssetGrid"
import OptionsPositions from "@/components/dashboard/OptionsPositions"
import PortfolioTransferHistory from "@/components/dashboard/PortfolioTransferHistory"
import CorporateActionImpacts from "@/components/dashboard/CorporateActionImpacts"

// Social media metadata for dashboard page
const pageTitle = "Trading Dashboard - LEADTRADE";
const pageDescription = "Monitor your portfolio performance, track positions, and analyze your trading activity with real-time market data on LEADTRADE.";
const pageImage = "/social/dashboard-thumbnail.svg";
const pageKeywords = "trading dashboard, portfolio management, stock positions, trading analytics, market data, investment tracking";
---

<Layout 
    title={pageTitle}
    description={pageDescription}
    image={pageImage}
    keywords={pageKeywords}
    type="website"
    url="/dashboard"
>
    <AppShell client:only="react">
        <ProtectedRoute client:load>
        <div class="content-spacing">
            {/* Page Header with better spacing */}
            <div class="flex items-center justify-between pb-2 border-b">
                <div>
                    <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Dashboard</h1>
                    <p class="text-muted-foreground mt-1">Monitor your portfolio and trading activity</p>
                </div>
            </div>
            
            {/* Portfolio Summary Cards with elevation */}
            <div class="pt-2">
                <PortfolioSummary client:load />
            </div>
            
            {/* Main Content Grid with proper spacing */}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* Left Column - 2/3 width */}
                <div class="lg:col-span-2 space-y-6">
                    {/* Main Asset Grid */}
                    <AssetGrid client:load />
                    
                    {/* Options Positions */}
                    <OptionsPositions client:load />
                    
                    {/* Corporate Action Impacts */}
                    <CorporateActionImpacts client:load />
                </div>
                
                {/* Right Column - 1/3 width */}
                <div class="space-y-6">
                    {/* Transfer History Section */}
                    <PortfolioTransferHistory client:load />
                </div>
            </div>
            
            {/* Trading Dashboard - Full Width */}
            <div class="pt-4">
                <TradingDashboard client:load />
            </div>
        </div>
        </ProtectedRoute>
    </AppShell>
</Layout>