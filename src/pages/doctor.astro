            <!-- Eye highlights -->
            <circle cx="73" cy="92" r="4" fill="white" opacity="0.9"></circle>
            <circle cx="133" cy="92" r="4" fill="white" opacity="0.9"></circle>

            <!-- Nose -->
            <ellipse cx="100" cy="115" rx="10" ry="15" fill="#d4a574"></ellipse>
            <ellipse cx="95" cy="115" rx="3" ry="5" fill="#b88a5a"></ellipse>
            <ellipse cx="105" cy="115" rx="3" ry="5" fill="#b88a5a"></ellipse>

            <!-- Beard -->
            <ellipse cx="100" cy="150" rx="50" ry="40" fill="#1a1a1a"></ellipse>
            <path d="M 55 135 Q 100 165, 145 135" fill="#1a1a1a"></path>

            <!-- Mouth -->
            <path
                d="M 75 140 Q 100 148, 125 140"
                stroke="#8b6f47"
                stroke-width="3"
                fill="none"
                stroke-linecap="round"></path>

            <!-- T-shirt -->
            <path
                d="M 30 185 Q 100 195, 170 185 L 170 200 L 30 200 Z"
                fill="#2d2d2d"></path>
        </div>
    </body>

    <script is:inline>
        // Googly eyes that follow cursor
        document.addEventListener("DOMContentLoaded", function () {
            const leftPupil = document.getElementById("leftPupil");
            const rightPupil = document.getElementById("rightPupil");
