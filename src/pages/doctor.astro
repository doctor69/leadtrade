        <script is:inline>
            document.addEventListener('DOMContentLoaded', function () {
                const leftGroup  = document.getElementById('leftPupilGroup');
                const rightGroup = document.getElementById('rightPupilGroup');
                const avatar     = document.getElementById('avatarWrap');
                if (!leftGroup || !rightGroup || !avatar) return;

                document.addEventListener('mousemove', function (e) {
                    const r = avatar.getBoundingClientRect();
                    const lx = r.left + r.width * 0.39, ly = r.top + r.height * 0.34;
                    const rx = r.left + r.width * 0.61, ry = r.top + r.height * 0.34;
                    const la = Math.atan2(e.clientY - ly, e.clientX - lx);
                    const ra = Math.atan2(e.clientY - ry, e.clientX - rx);
                    const m = 4;
                    leftGroup.setAttribute('transform',  `translate(${Math.cos(la)*m},${Math.sin(la)*m})`);
                    rightGroup.setAttribute('transform', `translate(${Math.cos(ra)*m},${Math.sin(ra)*m})`);

                    // Scared when cursor gets too close
                    const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
                    const dist = Math.sqrt((e.clientX - cx) ** 2 + (e.clientY - cy) ** 2);
                    avatar.classList.toggle('scared', dist < 55);
                });
            });
        </script>
