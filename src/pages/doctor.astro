---
// Public résumé page — no authentication required.
//
// Three renderings share one source of truth (src/data/resume.ts):
//   1. The on-screen UI below.
//   2. The print stylesheet, which linearizes to a single column for PDF export
//      so applicant tracking systems parse it cleanly.
//   3. The schema.org JSON-LD + <details> profile block at the end of the
//      document, which is what AI crawlers and LLM agents read.
export const prerender = true;

import {
  achievements,
  certifications,
  contactChannels,
  coreCompetencies,
  domains,
  education,
  experience,
  metrics,
  profile,
  projects,
  skillGroups,
  spokenLanguages,
  summary,
  toPlainText,
} from '../data/resume';

const siteUrl = 'https://leadtrade.app';
const pageUrl = profile.resumeUrl;
const lastUpdated = new Date().toISOString();

const metaDescription = `${profile.name} — ${profile.headline} with ${profile.yearsExperience} years building enterprise payment systems in Java, Spring Boot, microservices, React, and AWS. 50+ production APIs, 2M+ daily transactions, 99.95% uptime.`;

const allSkills = skillGroups.flatMap((group) => group.items);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${pageUrl}#profilepage`,
  url: pageUrl,
  name: `${profile.name} — ${profile.headline} Resume`,
  description: metaDescription,
  dateModified: lastUpdated,
  inLanguage: 'en-US',
  primaryImageOfPage: `${siteUrl}${profile.photo}`,
  mainEntity: {
    '@type': 'Person',
    '@id': `${pageUrl}#person`,
    name: profile.name,
    alternateName: profile.nickname,
    jobTitle: profile.headline,
    description: metaDescription,
    email: `mailto:${profile.email}`,
    url: pageUrl,
    image: `${siteUrl}${profile.photo}`,
    sameAs: [profile.github, siteUrl, 'https://predix.vip'],
    address: {
      '@type': 'PostalAddress',
      addressCountry: profile.locationCountry,
    },
    knowsAbout: [...coreCompetencies, ...allSkills],
    knowsLanguage: [{ '@type': 'Language', name: 'English' }],
    worksFor: {
      '@type': 'Organization',
      name: experience[0].company,
      location: experience[0].location,
    },
    hasOccupation: experience.map((job) => ({
      '@type': 'Occupation',
      name: job.title,
      occupationalCategory: '15-1252.00 Software Developers',
      description: `${toPlainText(job.scope)} ${job.bullets.map(toPlainText).join(' ')}`,
      occupationLocation: { '@type': 'Place', name: job.location },
      hiringOrganization: { '@type': 'Organization', name: job.company },
      startDate: job.startDate,
      ...(job.endDate ? { endDate: job.endDate } : {}),
      skills: allSkills.join(', '),
    })),
    alumniOf: education.map((entry) => ({
      '@type': 'EducationalOrganization',
      name: entry.school,
      location: entry.location,
    })),
    hasCredential: [
      ...education.map((entry) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'degree',
        name: `${entry.degree}, ${entry.field}`,
        educationalLevel: 'Associate Degree',
        recognizedBy: { '@type': 'EducationalOrganization', name: entry.school },
      })),
      ...certifications.map((cert) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certification',
        name: cert.name,
        description: cert.detail,
        recognizedBy: { '@type': 'Organization', name: cert.issuer },
      })),
    ],
    seeks: {
      '@type': 'Demand',
      name: `${profile.targetTitles.join(', ')} roles`,
      availableAtOrFrom: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: profile.locationCountry } },
    },
    subjectOf: projects.map((project) => ({
      '@type': 'CreativeWork',
      name: project.name,
      headline: project.tagline,
      ...(project.url ? { url: project.url } : {}),
      abstract: project.bullets.map(toPlainText).join(' '),
      keywords: project.tech.join(', '),
    })),
  },
};
---

<!doctype html>
<html lang="en" class="resume-page">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{profile.name} — {profile.headline} | Resume</title>

        <!-- ── Discovery & AI-crawler metadata ─────────────── -->
        <meta name="description" content={metaDescription} />
        <meta name="author" content={profile.name} />
        <link rel="canonical" href={pageUrl} />
        <meta
            name="robots"
            content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
        <!-- Plain-text rendering for LLM agents and ATS parsers that don't execute CSS. -->
        <link
            rel="alternate"
            type="text/plain"
            href="/doctor/resume.txt"
            title="Plain-text resume for AI agents and applicant tracking systems"
        />

        <meta property="og:type" content="profile" />
        <meta property="og:title" content={`${profile.name} — ${profile.headline}`} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={`${siteUrl}${profile.photo}`} />
        <meta property="profile:first_name" content="Saket" />
        <meta property="profile:last_name" content="Sharma" />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={`${profile.name} — ${profile.headline}`} />
        <meta name="twitter:description" content={metaDescription} />

        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
        />

        <style>
            /* ── Design tokens ──────────────────────────────── */
            :root {
                --ink:        #0f172a;
                --ink-soft:   #334155;
                --ink-muted:  #64748b;
                --ink-faint:  #94a3b8;
                --paper:      #ffffff;
                --paper-alt:  #f8fafc;
                --line:       #e2e8f0;
                --line-soft:  #f1f5f9;
                --navy:       #0b1220;
                --navy-2:     #16233b;
                --accent:     #2563eb;
                --accent-dk:  #1d4ed8;
                --accent-lt:  #93c5fd;
                --accent-bg:  #eff6ff;
                --backdrop:   #dfe5ee;
                --backdrop-2: #eef2f7;
                --shadow:     0 24px 60px rgba(15,23,42,0.14), 0 2px 8px rgba(15,23,42,0.07);
            }

            @media (prefers-color-scheme: dark) {
                :root {
                    --backdrop:   #070b14;
                    --backdrop-2: #0d1526;
                    --shadow:     0 24px 70px rgba(0,0,0,0.6), 0 0 0 1px rgba(148,163,184,0.09);
                }
            }

            /* ── Reset ──────────────────────────────────────── */
            *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

            html, body {
                font-family: 'Inter', 'Calibri', system-ui, -apple-system, sans-serif;
                font-size: 10pt;
                line-height: 1.5;
                color: var(--ink);
                background:
                    radial-gradient(1200px 600px at 50% -10%, var(--backdrop-2), transparent 70%),
                    var(--backdrop);
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
            }
            a { color: inherit; text-decoration: none; }
            a:hover { text-decoration: underline; }
            :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

            /* ── Toolbar ────────────────────────────────────── */
            .toolbar {
                position: fixed;
                top: 16px;
                right: 16px;
                z-index: 1000;
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .tool-btn {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 9px 16px;
                border: 1px solid rgba(255,255,255,0.16);
                border-radius: 999px;
                font-family: inherit;
                font-size: 11.5px;
                font-weight: 600;
                letter-spacing: 0.2px;
                cursor: pointer;
                transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
                background: linear-gradient(135deg, var(--accent), #0ea5e9);
                color: #fff;
                box-shadow: 0 6px 18px rgba(37,99,235,0.35);
            }
            .tool-btn.secondary {
                background: rgba(15,23,42,0.86);
                color: rgba(255,255,255,0.88);
                box-shadow: 0 6px 18px rgba(15,23,42,0.22);
                backdrop-filter: blur(6px);
            }
            .tool-btn:hover { transform: translateY(-2px); text-decoration: none; }
            .tool-btn:active { transform: translateY(0); }

            /* ── Paper ──────────────────────────────────────── */
            .resume {
                max-width: 1040px;
                margin: 40px auto;
                background: var(--paper);
                border-radius: 20px;
                box-shadow: var(--shadow);
            }

            /* ── Header ─────────────────────────────────────── */
            .resume-header {
                position: relative;
                background:
                    radial-gradient(ellipse 60% 120% at 82% 50%, rgba(37,99,235,0.28) 0%, transparent 66%),
                    linear-gradient(135deg, var(--navy) 0%, var(--navy-2) 55%, var(--navy) 100%);
                padding: 34px 38px 30px;
                display: flex;
                align-items: center;
                gap: 26px;
                border-radius: 20px 20px 0 0;
                overflow: hidden;
            }
            .resume-header::after {
                content: '';
                position: absolute;
                bottom: 0; left: 0; right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--accent) 0%, #06b6d4 42%, #8b5cf6 72%, #ec4899 100%);
            }

            /* ── Avatar ─────────────────────────────────────── */
            .avatar-wrap {
                position: relative;
                flex-shrink: 0;
                width: 104px;
                height: 104px;
                z-index: 1;
                cursor: pointer;
                transition: transform 0.3s cubic-bezier(.34,1.56,.64,1), filter 0.3s ease;
            }
            .avatar-wrap::before {
                content: '';
                position: absolute;
                inset: -3px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--accent), #06b6d4, #8b5cf6);
                z-index: -1;
            }
            .avatar-wrap img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
                display: block;
                border: 3px solid var(--navy);
            }
            .eye-svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
            .avatar-wrap:hover {
                transform: scale(1.1) rotate(5deg);
                filter: drop-shadow(0 0 20px rgba(37,99,235,0.7));
            }
            .avatar-wrap.scared {
                transform: scale(0.78) translateY(12px) !important;
                filter: drop-shadow(0 0 8px rgba(239,68,68,0.6)) !important;
            }

            /* ── Header text ────────────────────────────────── */
            .header-info { flex: 1; min-width: 0; position: relative; z-index: 1; }

            .header-name {
                font-size: 25pt;
                font-weight: 800;
                color: #fff;
                letter-spacing: -0.7pt;
                line-height: 1.05;
            }
            .header-nickname {
                font-size: 9.5pt;
                font-weight: 400;
                color: rgba(255,255,255,0.4);
                letter-spacing: 0.6pt;
                white-space: nowrap;
            }
            .header-title {
                font-size: 11pt;
                font-weight: 600;
                color: var(--accent-lt);
                margin-top: 6px;
                letter-spacing: 0.1pt;
            }
            .header-specialty {
                font-family: 'Newsreader', Georgia, serif;
                font-style: italic;
                font-size: 9.5pt;
                color: rgba(255,255,255,0.55);
                margin-top: 3px;
            }

            /* Metric strip */
            .metric-strip {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin: 14px 0 13px;
            }
            .metric {
                display: flex;
                align-items: baseline;
                gap: 5px;
                padding: 4px 11px;
                border-radius: 999px;
                background: rgba(255,255,255,0.055);
                border: 1px solid rgba(147,197,253,0.2);
            }
            .metric-value {
                font-size: 10.5pt;
                font-weight: 700;
                color: #fff;
                letter-spacing: -0.2pt;
            }
            .metric-label {
                font-size: 7pt;
                font-weight: 600;
                letter-spacing: 0.9pt;
                text-transform: uppercase;
                color: rgba(147,197,253,0.78);
            }

            .header-contact {
                display: flex;
                flex-wrap: wrap;
                gap: 8px 20px;
            }
            .contact-item {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 8.5pt;
                color: rgba(255,255,255,0.62);
            }
            .contact-icon { font-size: 10px; opacity: 0.75; }
            .contact-item a { color: var(--accent-lt); font-weight: 500; }
            .contact-item a:hover { color: #dbeafe; }

            /* ── Body grid ──────────────────────────────────── */
            /* DOM order is main → aside so that print and screen-reader order stay
               linear (summary first); the grid places the aside on the left. */
            .resume-body {
                display: grid;
                grid-template-columns: 238px 1fr;
                border-radius: 0 0 20px 20px;
                overflow: hidden;
            }
            .main-content { grid-column: 2; grid-row: 1; padding: 26px 30px 30px; background: var(--paper); }
            .sidebar      { grid-column: 1; grid-row: 1; }

            /* ── Sidebar ────────────────────────────────────── */
            .sidebar {
                background: linear-gradient(180deg, var(--navy) 0%, #0e1729 100%);
                padding: 26px 20px 30px;
                color: rgba(255,255,255,0.82);
            }
            .sidebar-section { margin-bottom: 24px; }
            .sidebar-section:last-child { margin-bottom: 0; }

            .sidebar-title {
                font-size: 7pt;
                font-weight: 700;
                letter-spacing: 1.9pt;
                text-transform: uppercase;
                color: #60a5fa;
                margin-bottom: 12px;
                padding-bottom: 7px;
                border-bottom: 1px solid rgba(255,255,255,0.09);
            }

            .skill-group { margin-bottom: 11px; }
            .skill-group:last-child { margin-bottom: 0; }
            .skill-group-label {
                font-size: 6.8pt;
                font-weight: 600;
                color: rgba(255,255,255,0.42);
                text-transform: uppercase;
                letter-spacing: 0.7pt;
                margin-bottom: 5px;
            }
            .skill-tags { display: flex; flex-wrap: wrap; gap: 3px; }
            .skill-tag {
                background: rgba(37,99,235,0.2);
                border: 1px solid rgba(96,165,250,0.28);
                color: rgba(255,255,255,0.82);
                padding: 2px 7px;
                border-radius: 5px;
                font-size: 7.4pt;
                line-height: 1.55;
                transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
            }
            .skill-tag:hover {
                background: rgba(37,99,235,0.42);
                border-color: rgba(96,165,250,0.6);
                color: #fff;
            }

            .edu-item, .cert-item { line-height: 1.4; }
            .edu-degree { font-size: 8.5pt; font-weight: 600; color: #fff; }
            .edu-school { font-size: 8pt; color: rgba(255,255,255,0.5); margin-top: 2px; }
            .edu-year   { font-size: 7.5pt; color: #60a5fa; font-weight: 500; margin-top: 2px; }

            .cert-item {
                font-size: 8.4pt;
                color: rgba(255,255,255,0.8);
                padding: 7px 9px 7px 12px;
                background: rgba(255,255,255,0.04);
                border-radius: 7px;
                border-left: 2px solid var(--accent);
            }
            .cert-issuer { display: block; font-size: 7.2pt; color: rgba(255,255,255,0.42); margin-top: 3px; }

            /* ── Sections ───────────────────────────────────── */
            .main-section { margin-bottom: 20px; }
            .main-section:last-child { margin-bottom: 0; }

            .section-title {
                position: relative;
                font-size: 7.6pt;
                font-weight: 700;
                letter-spacing: 1.6pt;
                text-transform: uppercase;
                color: var(--accent);
                margin-bottom: 11px;
                padding-bottom: 6px;
                border-bottom: 1.5px solid var(--line);
            }
            .section-title::after {
                content: '';
                position: absolute;
                bottom: -1.5px; left: 0;
                width: 38px; height: 1.5px;
                background: var(--accent);
                border-radius: 2px;
            }

            /* ── Summary ────────────────────────────────────── */
            .summary-list { list-style: none; }
            .summary-list li {
                position: relative;
                padding-left: 15px;
                margin-bottom: 5px;
                font-size: 9pt;
                line-height: 1.5;
                color: var(--ink-soft);
            }
            .summary-list li::before {
                content: '\2022';
                position: absolute;
                left: 0; top: 1px;
                color: var(--accent);
                font-size: 8pt;
            }

            /* ── Core competencies ──────────────────────────── */
            .competency-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 4px 10px;
            }
            .competency {
                position: relative;
                padding-left: 14px;
                font-size: 8.2pt;
                line-height: 1.45;
                color: var(--ink-soft);
            }
            .competency::before {
                content: '';
                position: absolute;
                left: 2px; top: 6px;
                width: 4px; height: 4px;
                border-radius: 50%;
                background: var(--accent);
            }

            /* ── Experience ─────────────────────────────────── */
            .job { margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line-soft); }
            .job:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }

            .job-top, .job-sub {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                gap: 12px;
            }
            .job-company {
                font-size: 10.5pt;
                font-weight: 700;
                color: var(--ink);
                letter-spacing: 0.1pt;
                text-transform: uppercase;
            }
            .job-location { font-size: 8pt; color: var(--ink-faint); white-space: nowrap; }
            .job-sub { margin: 1px 0 5px; }
            .job-title-text { font-size: 9.2pt; font-weight: 600; color: var(--accent); }
            .job-date { font-size: 8pt; color: var(--ink-muted); font-style: italic; white-space: nowrap; }

            .job-scope {
                font-family: 'Newsreader', Georgia, serif;
                font-size: 8.8pt;
                font-style: italic;
                line-height: 1.45;
                color: var(--ink-muted);
                padding: 6px 0 8px 11px;
                border-left: 2px solid var(--line);
                margin-bottom: 7px;
            }

            .job-bullets, .project-bullets { list-style: none; }
            .job-bullets li, .project-bullets li {
                position: relative;
                padding-left: 14px;
                margin-bottom: 4px;
                font-size: 8.5pt;
                line-height: 1.45;
                color: var(--ink-soft);
            }
            .job-bullets li::before {
                content: '';
                position: absolute;
                left: 3px; top: 6px;
                width: 4px; height: 4px;
                border-radius: 50%;
                background: var(--accent-lt);
            }
            .project-bullets li::before {
                content: '\2022';
                position: absolute;
                left: 0; top: 0;
                color: var(--accent);
                font-size: 8pt;
            }

            strong { font-weight: 600; color: var(--ink); }
            code {
                font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
                font-size: 0.92em;
                background: var(--accent-bg);
                border-radius: 3px;
                padding: 0 3px;
            }

            /* ── Achievements ───────────────────────────────── */
            .achievement-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
            .achievement-item {
                position: relative;
                padding: 8px 11px 8px 26px;
                background: var(--paper-alt);
                border-radius: 8px;
                border-left: 2px solid var(--accent);
                font-size: 8.4pt;
                line-height: 1.4;
                color: var(--ink-soft);
            }
            .achievement-item::before {
                content: '↑';
                position: absolute;
                left: 9px; top: 8px;
                color: var(--accent);
                font-weight: 700;
                font-size: 9pt;
            }

            /* ── Projects ───────────────────────────────────── */
            .project-card {
                margin-bottom: 12px;
                padding: 13px 15px;
                border-radius: 11px;
                border: 1px solid var(--line);
                background: var(--paper-alt);
                transition: box-shadow 0.2s ease, border-color 0.2s ease;
            }
            .project-card:last-child { margin-bottom: 0; }
            .project-card:hover { box-shadow: 0 3px 14px rgba(37,99,235,0.1); border-color: #bfdbfe; }

            .project-header {
                display: flex;
                align-items: baseline;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 6px;
                margin-bottom: 6px;
            }
            .project-name { font-size: 10pt; font-weight: 700; color: var(--ink); }
            .project-name a:hover { color: var(--accent); text-decoration: none; }
            .project-tagline { font-size: 8.4pt; color: var(--accent); font-weight: 500; }

            .project-tech { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 8px; }
            .project-tech-tag {
                background: var(--accent-bg);
                border: 1px solid #bfdbfe;
                color: var(--accent-dk);
                padding: 1px 7px;
                border-radius: 5px;
                font-size: 7pt;
                font-weight: 500;
                line-height: 1.65;
            }

            /* ── Machine-readable profile (AI crawlers) ─────── */
            .machine-block {
                margin: 0 30px 26px;
                border: 1px solid var(--line);
                border-radius: 11px;
                background: var(--paper-alt);
                overflow: hidden;
            }
            .machine-block > summary {
                cursor: pointer;
                list-style: none;
                padding: 11px 15px;
                font-size: 7.6pt;
                font-weight: 700;
                letter-spacing: 1.4pt;
                text-transform: uppercase;
                color: var(--ink-muted);
                display: flex;
                align-items: center;
                gap: 8px;
            }
            .machine-block > summary::-webkit-details-marker { display: none; }
            .machine-block > summary::before { content: '⌗'; color: var(--accent); font-size: 11pt; }
            .machine-block > summary:hover { color: var(--accent); }
            .machine-body { padding: 0 15px 15px; }
            .machine-body dl {
                display: grid;
                grid-template-columns: 150px 1fr;
                gap: 4px 12px;
                font-size: 8.2pt;
                line-height: 1.5;
            }
            .machine-body dt { font-weight: 600; color: var(--ink-muted); }
            .machine-body dd { color: var(--ink-soft); }
            .machine-note {
                margin-top: 11px;
                padding-top: 10px;
                border-top: 1px solid var(--line);
                font-size: 7.8pt;
                color: var(--ink-muted);
                line-height: 1.5;
            }

            /* ── Entry animation ────────────────────────────── */
            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(14px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .anim-in { opacity: 0; animation: fadeUp 0.45s ease forwards; }
            @media (prefers-reduced-motion: reduce) {
                .anim-in { opacity: 1; animation: none; }
                *, *::before, *::after { transition-duration: 0.01ms !important; }
            }

            /* Screen/print swaps */
            .print-only { display: none; }

            /* ── Print / PDF ────────────────────────────────── */
            /* The PDF is what gets uploaded to job applications, so it drops to a
               single linear column: one text flow, standard section headings, and
               no colour-dependent content — the shape ATS parsers read reliably. */
            @page { size: Letter; margin: 0.45in 0.5in; }

            @media print {
                :root {
                    --backdrop: #fff;
                    --backdrop-2: #fff;
                    --shadow: none;
                }
                html, body {
                    background: #fff;
                    font-size: 9.2pt;
                    line-height: 1.32;
                }
                .toolbar, .avatar-wrap, .machine-block { display: none !important; }
                .print-only { display: block; }

                .resume { max-width: 100%; margin: 0; border-radius: 0; box-shadow: none; }

                .resume-header {
                    position: static;
                    display: block;
                    padding: 0 0 8px;
                    border-radius: 0;
                    background: #fff !important;
                    border-bottom: 2px solid var(--ink);
                }
                .resume-header::after { display: none; }
                .header-name { font-size: 20pt; color: var(--ink); letter-spacing: -0.4pt; }
                .header-nickname { color: var(--ink-muted); }
                .header-title { font-size: 10.5pt; color: var(--ink); font-weight: 700; margin-top: 2px; }
                .header-specialty { color: var(--ink-muted); }
                .metric-strip { gap: 0 14px; margin: 7px 0 6px; }
                .metric { background: none; border: none; padding: 0; }
                .metric-value { color: var(--ink); font-size: 9.5pt; }
                .metric-label { color: var(--ink-muted); }
                .contact-item { color: var(--ink-soft); font-size: 8.6pt; }
                .contact-item a { color: var(--ink-soft); }

                /* Single linear column: main content, then skills/education. */
                .resume-body { display: block; border-radius: 0; }
                .main-content { padding: 12px 0 0; }
                .sidebar {
                    background: #fff !important;
                    color: var(--ink-soft);
                    padding: 0;
                    margin-top: 4px;
                }
                .sidebar-title, .section-title {
                    color: var(--ink);
                    font-size: 8pt;
                    border-bottom: 1px solid var(--ink-faint);
                    margin-bottom: 7px;
                }
                /* Letter-spacing makes PDF text extract as "S U M M A R Y", which
                   defeats ATS section detection and keyword matching. Headings stay
                   uppercase and bold, but at normal tracking, in print only. */
                .section-title, .sidebar-title, .metric-label,
                .job-company, .skill-group-label {
                    letter-spacing: normal;
                }
                .contact-icon { display: none; }
                .header-contact { gap: 4px 16px; }
                .section-title::after { background: var(--ink); }
                .skill-tags, .project-tech { display: none; }
                .skill-group-label { display: none; }
                .print-skill-line { font-size: 8.2pt; line-height: 1.42; color: var(--ink-soft); margin-bottom: 2px; }

                /* Typographic scale for paper. Inter's large x-height keeps these
                   sizes readable while fitting the full resume in three pages —
                   a fourth page holding only the tail sections reads as padding. */
                .summary-list li { font-size: 8.4pt; }
                .job-bullets li, .project-bullets li { font-size: 8.2pt; }
                .job-scope { font-size: 8.3pt; }
                .achievement-item { font-size: 8.1pt; }
                .competency { font-size: 8pt; }
                .print-skill-line strong { color: var(--ink); }
                .edu-degree, .edu-school, .edu-year, .cert-item { color: var(--ink-soft); }
                .edu-degree { color: var(--ink); }
                .cert-item { background: none; border-left: 2px solid var(--ink-faint); padding: 2px 0 2px 9px; }
                .cert-issuer { color: var(--ink-muted); }

                .job-scope { color: var(--ink-muted); border-left-color: var(--ink-faint); padding: 3px 0 3px 9px; }
                .job-title-text, .project-tagline, .project-name a { color: var(--ink); }
                .job-bullets li::before, .competency::before { background: var(--ink-soft); }
                .summary-list li::before, .project-bullets li::before { color: var(--ink-soft); }
                .achievement-item, .project-card {
                    background: none;
                    border: none;
                    border-left: 2px solid var(--ink-faint);
                    border-radius: 0;
                    padding: 1px 0 1px 9px;
                }
                .project-card { border-left: none; padding-left: 0; margin-bottom: 8px; }
                .achievement-item::before { color: var(--ink-soft); }
                .competency-grid { gap: 2px 10px; }

                /* Expand links so a printed page keeps its references. */
                .project-name a::after {
                    content: ' — ' attr(href);
                    font-weight: 400;
                    font-size: 7.6pt;
                    color: var(--ink-muted);
                }

                /* Let long roles split across pages — forcing whole jobs to stay
                   together stranded ~1.3 pages of whitespace. Instead, keep each
                   heading glued to the text that follows it. */
                .job { break-inside: auto; }
                .job-bullets li, .summary-list li, .project-bullets li,
                .project-card, .achievement-item, .edu-item, .cert-item,
                .print-skill-line { break-inside: avoid; }
                .section-title, .sidebar-title, .job-top, .job-sub,
                .job-scope, .project-header, .skill-group-label { break-after: avoid; }
                .main-section, .sidebar-section { break-inside: auto; }

                /* Vertical rhythm, tightened for paper: the same content at screen
                   spacing ran to four pages, with the last holding only the tail
                   sections. */
                .main-section { margin-bottom: 9px; }
                .sidebar-section { margin-bottom: 8px; }
                .section-title, .sidebar-title { margin-bottom: 5px; padding-bottom: 3px; }
                .job { margin-bottom: 9px; padding-bottom: 9px; }
                .job-scope { margin-bottom: 4px; }
                .job-bullets li, .summary-list li, .project-bullets li,
                .competency { margin-bottom: 2px; }
                .achievement-grid { gap: 3px 10px; }
                .project-card { margin-bottom: 7px; }
                .skill-group { margin-bottom: 0; }
                .edu-item { margin-bottom: 3px; }
                /* These three print as "Label: values", so the section heading above
                   them is a duplicate that costs two lines each. */
                .sidebar-compact > .sidebar-title { display: none; }
                .sidebar-compact { margin-bottom: 2px; }

                a { text-decoration: none; }
            }

            /* ── Responsive ─────────────────────────────────── */
            @media (max-width: 860px) {
                .competency-grid { grid-template-columns: repeat(2, 1fr); }
            }
            @media (max-width: 740px) {
                .resume { margin: 0; border-radius: 0; }
                .resume-header { border-radius: 0; flex-direction: column; text-align: center; padding: 28px 20px 24px; }
                .header-name { font-size: 21pt; }
                .metric-strip, .header-contact { justify-content: center; }
                .avatar-wrap { margin: 0 auto; }
                .resume-body { display: block; border-radius: 0; }
                .main-content { padding: 22px 20px; }
                .sidebar { padding: 24px 20px 28px; }
                .achievement-grid, .competency-grid { grid-template-columns: 1fr; }
                .machine-block { margin: 0 20px 22px; }
                .machine-body dl { grid-template-columns: 1fr; gap: 0 0; }
                .machine-body dt { margin-top: 7px; }
                .toolbar { top: 10px; right: 10px; gap: 6px; }
                .tool-btn { font-size: 10.5px; padding: 7px 13px; }
            }
        </style>
    </head>

    <body>
        <nav class="toolbar" aria-label="Resume actions">
            <a
                class="tool-btn secondary"
                href="/doctor/resume.txt"
                title="Plain-text version for AI agents and ATS"
            >⌗ Plain text</a>
            <button class="tool-btn" type="button" id="printBtn">🖨 Print / PDF</button>
        </nav>

        <article class="resume" itemscope itemtype="https://schema.org/Person">

            <!-- ── Header ──────────────────────────────────── -->
            <header class="resume-header anim-in" style="animation-delay: 0ms;">
                <div class="avatar-wrap" id="avatarWrap" aria-hidden="true">
                    <img src={profile.photo} alt={profile.name} itemprop="image" />
                    <svg class="eye-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                        <g transform="translate(78, 65)">
                            <ellipse cx="0" cy="0" rx="14" ry="10" fill="white" opacity="0.9" />
                            <g id="leftPupilGroup">
                                <circle cx="0" cy="0" r="7" fill="#0f172a" />
                                <circle cx="2" cy="-2" r="2" fill="white" opacity="0.85" />
                            </g>
                        </g>
                        <g transform="translate(122, 65)">
                            <ellipse cx="0" cy="0" rx="14" ry="10" fill="white" opacity="0.9" />
                            <g id="rightPupilGroup">
                                <circle cx="0" cy="0" r="7" fill="#0f172a" />
                                <circle cx="2" cy="-2" r="2" fill="white" opacity="0.85" />
                            </g>
                        </g>
                    </svg>
                </div>

                <div class="header-info">
                    <h1 class="header-name" itemprop="name">
                        {profile.name.toUpperCase()}
                        <span class="header-nickname">— &ldquo;{profile.nickname.toUpperCase()}&rdquo;</span>
                    </h1>
                    <p class="header-title" itemprop="jobTitle">
                        {profile.headline} · {profile.yearsExperience} Years
                    </p>
                    <p class="header-specialty">{profile.specialty}</p>

                    <div class="metric-strip">
                        {metrics.map((metric) => (
                            <span class="metric">
                                <span class="metric-value">{metric.value}</span>
                                <span class="metric-label">{metric.label}</span>
                            </span>
                        ))}
                    </div>

                    <address class="header-contact">
                        {contactChannels.map((channel) => (
                            <span class="contact-item">
                                <span class="contact-icon" aria-hidden="true">{channel.icon}</span>
                                {channel.href ? (
                                    <a
                                        href={channel.href}
                                        rel={channel.href.startsWith('http') ? 'noopener noreferrer me' : undefined}
                                        target={channel.href.startsWith('http') ? '_blank' : undefined}
                                    >{channel.value}</a>
                                ) : (
                                    <span>{channel.value}</span>
                                )}
                            </span>
                        ))}
                    </address>
                </div>
            </header>

            <!-- ── Body ────────────────────────────────────── -->
            <div class="resume-body">

                <!-- Main column (first in DOM → first in print & reading order) -->
                <main class="main-content">

                    <section class="main-section anim-in" style="animation-delay:100ms">
                        <h2 class="section-title">Professional Summary</h2>
                        <ul class="summary-list">
                            {summary.map((line) => <li set:html={line} />)}
                        </ul>
                    </section>

                    <section class="main-section anim-in" style="animation-delay:130ms">
                        <h2 class="section-title">Core Competencies</h2>
                        <div class="competency-grid">
                            {coreCompetencies.map((item) => <span class="competency">{item}</span>)}
                        </div>
                    </section>

                    <section class="main-section anim-in" style="animation-delay:170ms">
                        <h2 class="section-title">Professional Experience</h2>
                        {experience.map((job) => (
                            <div class="job">
                                <div class="job-top">
                                    <h3 class="job-company">{job.company}</h3>
                                    <span class="job-location">{job.location}</span>
                                </div>
                                <div class="job-sub">
                                    <span class="job-title-text">{job.title}</span>
                                    <span class="job-date">
                                        <time datetime={job.startDate}>{job.period.split('–')[0].trim()}</time>
                                        {' – '}
                                        {job.endDate
                                            ? <time datetime={job.endDate}>{job.period.split('–')[1].trim()}</time>
                                            : <span>Present</span>}
                                    </span>
                                </div>
                                <p class="job-scope">{job.scope}</p>
                                <ul class="job-bullets">
                                    {job.bullets.map((bullet) => <li set:html={bullet} />)}
                                </ul>
                            </div>
                        ))}
                    </section>

                    <section class="main-section anim-in" style="animation-delay:220ms">
                        <h2 class="section-title">Key Achievements</h2>
                        <div class="achievement-grid">
                            {achievements.map((item) => <div class="achievement-item" set:html={item} />)}
                        </div>
                    </section>

                    <section class="main-section anim-in" style="animation-delay:260ms">
                        <h2 class="section-title">Projects</h2>
                        {projects.map((project) => (
                            <div class="project-card">
                                <div class="project-header">
                                    <h3 class="project-name">
                                        {project.url
                                            ? <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} ↗</a>
                                            : project.name}
                                    </h3>
                                    <span class="project-tagline">{project.tagline}</span>
                                </div>
                                <div class="project-tech">
                                    {project.tech.map((tech) => <span class="project-tech-tag">{tech}</span>)}
                                </div>
                                <p class="print-only print-skill-line"><strong>Tech:</strong> {project.tech.join(' · ')}</p>
                                <ul class="project-bullets">
                                    {project.bullets.map((bullet) => <li set:html={bullet} />)}
                                </ul>
                            </div>
                        ))}
                    </section>

                </main>

                <!-- Sidebar (renders left on screen, flows last in print) -->
                <aside class="sidebar" aria-label="Skills, education and certifications">

                    <section class="sidebar-section anim-in" style="animation-delay:80ms">
                        <h2 class="sidebar-title">Technical Skills</h2>
                        {skillGroups.map((group) => (
                            <div class="skill-group">
                                <h3 class="skill-group-label">{group.label}</h3>
                                <div class="skill-tags">
                                    {group.items.map((item) => <span class="skill-tag">{item}</span>)}
                                </div>
                                <p class="print-only print-skill-line">
                                    <strong>{group.label}:</strong> {group.items.join(', ')}
                                </p>
                            </div>
                        ))}
                    </section>

                    <section class="sidebar-section anim-in" style="animation-delay:150ms">
                        <h2 class="sidebar-title">Education</h2>
                        {education.map((entry) => (
                            <div class="edu-item">
                                <div class="edu-degree">{entry.degree} — {entry.field}</div>
                                <div class="edu-school">{entry.school} · {entry.location}</div>
                                <div class="edu-year">{entry.year}</div>
                            </div>
                        ))}
                    </section>

                    <section class="sidebar-section anim-in" style="animation-delay:190ms">
                        <h2 class="sidebar-title">Certifications</h2>
                        {certifications.map((cert) => (
                            <div class="cert-item">
                                {cert.name} — {cert.detail}
                                <span class="cert-issuer">{cert.issuer}</span>
                            </div>
                        ))}
                    </section>

                    <section class="sidebar-section sidebar-compact anim-in" style="animation-delay:230ms">
                        <h2 class="sidebar-title">Domain Experience</h2>
                        <div class="skill-tags">
                            {domains.map((domain) => <span class="skill-tag">{domain}</span>)}
                        </div>
                        <p class="print-only print-skill-line"><strong>Domains:</strong> {domains.join(', ')}</p>
                    </section>

                    <section class="sidebar-section sidebar-compact anim-in" style="animation-delay:260ms">
                        <h2 class="sidebar-title">Open To</h2>
                        <div class="skill-tags">
                            {profile.targetTitles.map((title) => <span class="skill-tag">{title}</span>)}
                        </div>
                        <p class="print-only print-skill-line"><strong>Open To:</strong> {profile.targetTitles.join(', ')}</p>
                    </section>

                    <section class="sidebar-section sidebar-compact anim-in" style="animation-delay:290ms">
                        <h2 class="sidebar-title">Languages</h2>
                        <div class="skill-tags">
                            {spokenLanguages.map((lang) => <span class="skill-tag">{lang}</span>)}
                        </div>
                        <p class="print-only print-skill-line"><strong>Languages:</strong> {spokenLanguages.join(', ')}</p>
                    </section>

                </aside>
            </div>

            <!--
              ── Machine-readable profile ──────────────────────
              Structured, linear restatement of the resume for LLM crawlers and
              recruiter tooling. Deliberately visible (collapsed, not hidden):
              invisible keyword blocks are treated as manipulation by ATS vendors
              and search engines, and carry real ranking and disqualification risk.
            -->
            <details class="machine-block" id="ai-profile">
                <summary>Machine-readable profile — for AI agents &amp; recruiters</summary>
                <div class="machine-body">
                    <dl>
                        <dt>Candidate</dt>
                        <dd>{profile.name} ({profile.nickname})</dd>

                        <dt>Current title</dt>
                        <dd>{profile.headline}, {experience[0].company}</dd>

                        <dt>Years of experience</dt>
                        <dd>{profile.yearsExperience} years, professional software engineering</dd>

                        <dt>Open to roles</dt>
                        <dd>{profile.targetTitles.join(' · ')}</dd>

                        <dt>Primary stack</dt>
                        <dd>{profile.specialty}</dd>

                        <dt>Domains</dt>
                        <dd>Payments, financial services, brokerage &amp; trading systems</dd>

                        <dt>Employment history</dt>
                        <dd>
                            {experience.map((job) => (
                                <span>{job.title}, {job.company} ({job.location}) — {job.period}<br /></span>
                            ))}
                        </dd>

                        <dt>Education</dt>
                        <dd>
                            {education.map((entry) => (
                                <span>{entry.degree} in {entry.field}, {entry.school}, {entry.year}</span>
                            ))}
                        </dd>

                        <dt>Certifications</dt>
                        <dd>{certifications.map((cert) => `${cert.name} (${cert.detail})`).join('; ')}</dd>

                        <dt>Location</dt>
                        <dd>{profile.location}</dd>

                        <dt>Contact</dt>
                        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.github} rel="noopener noreferrer">{profile.github}</a></dd>

                        <dt>Full plain text</dt>
                        <dd><a href="/doctor/resume.txt">/doctor/resume.txt</a></dd>
                    </dl>
                    <p class="machine-note">
                        Every claim on this page is also published as schema.org
                        <code>ProfilePage</code>/<code>Person</code> JSON-LD in the document head, and as
                        linear plain text at <a href="/doctor/resume.txt">/doctor/resume.txt</a>.
                        Both are generated from the same source data as the visible resume, so they
                        cannot disagree with it.
                    </p>
                </div>
            </details>
        </article>

        <script is:inline>
            document.addEventListener('DOMContentLoaded', function () {
                var printBtn = document.getElementById('printBtn');
                if (printBtn) printBtn.addEventListener('click', function () { window.print(); });

                var leftGroup  = document.getElementById('leftPupilGroup');
                var rightGroup = document.getElementById('rightPupilGroup');
                var avatar     = document.getElementById('avatarWrap');
                if (!leftGroup || !rightGroup || !avatar) return;
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

                document.addEventListener('mousemove', function (e) {
                    var r = avatar.getBoundingClientRect();
                    var lx = r.left + r.width * 0.39, ly = r.top + r.height * 0.34;
                    var rx = r.left + r.width * 0.61, ry = r.top + r.height * 0.34;
                    var la = Math.atan2(e.clientY - ly, e.clientX - lx);
                    var ra = Math.atan2(e.clientY - ry, e.clientX - rx);
                    var m = 4;
                    leftGroup.setAttribute('transform',  'translate(' + Math.cos(la) * m + ',' + Math.sin(la) * m + ')');
                    rightGroup.setAttribute('transform', 'translate(' + Math.cos(ra) * m + ',' + Math.sin(ra) * m + ')');

                    var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
                    var dist = Math.sqrt(Math.pow(e.clientX - cx, 2) + Math.pow(e.clientY - cy, 2));
                    avatar.classList.toggle('scared', dist < 55);
                });
            });
        </script>
    </body>
</html>
