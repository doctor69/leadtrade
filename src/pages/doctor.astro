---
// No authentication required - public page
export const prerender = true;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Saket Sharma - Resume</title>
        <style is:global>
            @media print {
                body {
                    margin: 0;
                    padding: 0;
                }
                .page-break {
                    page-break-before: always;
                }
                .print-button {
                    display: none !important;
                }
                .no-print {
                    display: none !important;
                }
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: "Calibri", "Arial", sans-serif;
                font-size: 11pt;
                line-height: 1.4;
                color: #000;
                background: #fff;
                max-width: 8.5in;
                margin: 0 auto;
                padding: 0.5in;
            }

            h1 {
                font-size: 24pt;
                font-weight: bold;
                margin-bottom: 4pt;
                color: #1a1a1a;
                text-transform: uppercase;
                letter-spacing: 1pt;
            }

            .subtitle {
                font-size: 12pt;
                color: #2c3e50;
                margin-bottom: 8pt;
                font-weight: 600;
            }

            .contact {
                font-size: 10pt;
                margin-bottom: 12pt;
                color: #333;
            }

            h2 {
                font-size: 13pt;
                font-weight: bold;
                margin-top: 14pt;
                margin-bottom: 8pt;
                padding-bottom: 2pt;
                border-bottom: 2pt solid #2c3e50;
                color: #2c3e50;
                text-transform: uppercase;
                letter-spacing: 0.5pt;
            }

            h3 {
                font-size: 11pt;
                font-weight: bold;
                margin-top: 10pt;
                margin-bottom: 2pt;
                color: #1a1a1a;
            }

            .job-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 3pt;
            }

            .job-title {
                font-size: 10.5pt;
                font-weight: 600;
                color: #2c3e50;
            }

            .date {
                font-size: 10pt;
                font-style: italic;
                color: #555;
            }

            ul {
                margin-left: 20pt;
                margin-top: 4pt;
                margin-bottom: 8pt;
            }

            li {
                margin-bottom: 3pt;
                line-height: 1.35;
            }

            .skills-section {
                display: grid;
                grid-template-columns: 1fr;
                gap: 4pt;
                margin-top: 6pt;
            }

            .skill-row {
                display: flex;
                gap: 8pt;
            }

            .skill-label {
                font-weight: bold;
                min-width: 140pt;
                color: #2c3e50;
            }

            .skill-content {
                flex: 1;
            }

            .summary-list {
                margin-left: 15pt;
                margin-top: 6pt;
            }

            .summary-list li {
                margin-bottom: 4pt;
            }

            strong {
                font-weight: 600;
                color: #1a1a1a;
            }

            .keywords {
                font-size: 8pt;
                color: #fff;
                line-height: 1.2;
                margin-top: 12pt;
                background: #fff;
            }

            /* Print Button Styles */
            .print-button {
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 12px 24px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 14pt;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
                transition: all 0.3s ease;
                z-index: 1000;
            }

            .print-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
            }

            .print-button:hover::after {
                content: "print like comics";
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                font-size: 14pt;
                font-weight: 700;
                color: white;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            }

            .print-button:hover .button-text {
                opacity: 0;
            }

            .print-button:active {
                transform: translateY(0);
            }

            /* Random Animation Classes */
            .fade-in {
                animation: fadeIn 0.8s ease-in;
            }

            .slide-in-left {
                animation: slideInLeft 0.6s ease-out;
            }

            .slide-in-right {
                animation: slideInRight 0.6s ease-out;
            }

            .slide-in-up {
                animation: slideInUp 0.7s ease-out;
            }

            .zoom-in {
                animation: zoomIn 0.5s ease-out;
            }

            .bounce-in {
                animation: bounceIn 0.8s ease-out;
            }

            .rotate-in {
                animation: rotateIn 0.7s ease-out;
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                }
                to {
                    opacity: 1;
                }
            }

            @keyframes slideInLeft {
                from {
                    opacity: 0;
                    transform: translateX(-50px);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(50px);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @keyframes slideInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @keyframes zoomIn {
                from {
                    opacity: 0;
                    transform: scale(0.8);
                }
                to {
                    opacity: 1;
                    transform: scale(1);
                }
            }

            @keyframes bounceIn {
                0% {
                    opacity: 0;
                    transform: scale(0.3);
                }
                50% {
                    opacity: 1;
                    transform: scale(1.05);
                }
                70% {
                    transform: scale(0.9);
                }
                100% {
                    transform: scale(1);
                }
            }

            @keyframes rotateIn {
                from {
                    opacity: 0;
                    transform: rotate(-10deg) scale(0.9);
                }
                to {
                    opacity: 1;
                    transform: rotate(0) scale(1);
                }
            }

            /* Hover effects for sections */
            h2 {
                transition: all 0.3s ease;
            }

            h2:hover {
                color: #667eea;
                transform: translateX(5px);
            }

            li {
                transition: all 0.2s ease;
            }

            li:hover {
                transform: translateX(3px);
                color: #667eea;
            }

            .skill-row {
                transition: all 0.3s ease;
            }

            .skill-row:hover {
                background: linear-gradient(
                    90deg,
                    rgba(102, 126, 234, 0.05) 0%,
                    transparent 100%
                );
                padding-left: 8pt;
                border-left: 3px solid #667eea;
            }

            /* Avatar with googly eyes */
            .avatar-container {
                position: fixed;
                top: 20px;
                right: 20px;
                width: 150px;
                height: 150px;
                z-index: 999;
                transition: transform 0.3s ease;
                cursor: pointer;
            }

            .avatar-container:hover {
                transform: scale(1.15) rotate(5deg);
                filter: drop-shadow(0 0 20px rgba(102, 126, 234, 0.8));
            }

            .avatar-container.scared {
                transform: scale(0.7) translateY(15px);
            }

            @media print {
                .avatar-container {
                    display: none !important;
                }
            }
        </style>
    </head>
    <body>
        <!-- Avatar with googly eyes that follow cursor -->
        <div
            class="avatar-container no-print"
            onclick="window.print()"
            title="Print"
        >
            <div style="position: relative; width: 100%; height: 100%;">
                <!-- Your photo -->
                <img
                    src="/saket-photo.jpg"
                    alt="Saket Sharma"
                    style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: none;"
                />

                <!-- Moving pupils overlay with white eye backgrounds -->
                <svg
                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"
                    viewBox="0 0 200 200"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <!-- Left eye with moving pupil -->
                    <g transform="translate(78, 65)">
                        <!-- White eye background (covers real pupil) -->
                        <ellipse cx="0" cy="0" rx="16" ry="11" fill="white"
                        ></ellipse>
                        <!-- Moving pupil group -->
                        <g id="leftPupilGroup">
                            <!-- Dark pupil (bigger) -->
                            <circle
                                id="leftPupil"
                                cx="0"
                                cy="0"
                                r="8"
                                fill="#1a1a1a"></circle>
                            <!-- Highlight for realism -->
                            <circle
                                cx="2"
                                cy="-2"
                                r="2.5"
                                fill="white"
                                opacity="0.8"></circle>
                        </g>
                    </g>

                    <!-- Right eye with moving pupil -->
                    <g transform="translate(122, 65)">
                        <!-- White eye background (covers real pupil) -->
                        <ellipse cx="0" cy="0" rx="16" ry="11" fill="white"
                        ></ellipse>
                        <!-- Moving pupil group -->
                        <g id="rightPupilGroup">
                            <!-- Dark pupil (bigger) -->
                            <circle
                                id="rightPupil"
                                cx="0"
                                cy="0"
                                r="8"
                                fill="#1a1a1a"></circle>
                            <!-- Highlight for realism -->
                            <circle
                                cx="2"
                                cy="-2"
                                r="2.5"
                                fill="white"
                                opacity="0.8"></circle>
                        </g>
                    </g>
                </svg>
            </div>

            <script is:inline>
                // Googly eyes that follow cursor
                document.addEventListener("DOMContentLoaded", function () {
                    const leftPupilGroup =
                        document.getElementById("leftPupilGroup");
                    const rightPupilGroup =
                        document.getElementById("rightPupilGroup");
                    const avatar = document.querySelector(".avatar-container");

                    if (leftPupilGroup && rightPupilGroup && avatar) {
                        document.addEventListener("mousemove", function (e) {
                            const avatarRect = avatar.getBoundingClientRect();

                            // Eye positions (34% and 66% horizontally, 36% vertically - moved up)
                            const leftEyeX =
                                avatarRect.left + avatarRect.width * 0.39;
                            const leftEyeY =
                                avatarRect.top + avatarRect.height * 0.34;

                            const rightEyeX =
                                avatarRect.left + avatarRect.width * 0.61;
                            const rightEyeY =
                                avatarRect.top + avatarRect.height * 0.34;

                            // Calculate angles to cursor
                            const leftAngle = Math.atan2(
                                e.clientY - leftEyeY,
                                e.clientX - leftEyeX,
                            );
                            const rightAngle = Math.atan2(
                                e.clientY - rightEyeY,
                                e.clientX - rightEyeX,
                            );

                            // Maximum pupil movement (realistic eye movement)
                            // Smaller movement for natural look with real eyes
                            const maxMove = 5;

                            // Calculate pupil positions
                            const leftMoveX = Math.cos(leftAngle) * maxMove;
                            const leftMoveY = Math.sin(leftAngle) * maxMove;

                            const rightMoveX = Math.cos(rightAngle) * maxMove;
                            const rightMoveY = Math.sin(rightAngle) * maxMove;

                            // Update pupil groups (moves the entire pupil+highlight together)
                            leftPupilGroup.setAttribute(
                                "transform",
                                `translate(${leftMoveX}, ${leftMoveY})`,
                            );
                            rightPupilGroup.setAttribute(
                                "transform",
                                `translate(${rightMoveX}, ${rightMoveY})`,
                            );
                        });
                    }
                });
            </script>
