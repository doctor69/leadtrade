---
// No authentication required - public page
export const prerender = true;
---

<!doctype html>
<html lang="en" class="resume-page">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Saket Sharma — Resume</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />
        <style>
            /* ── Reset ─────────────────────────────────────── */
            *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

            /* ── Base ──────────────────────────────────────── */
            html, body {
                font-family: 'Inter', 'Calibri', system-ui, -apple-system, sans-serif;
                font-size: 10pt;
                line-height: 1.5;
                color: #0f172a;
                background: #e2e8f0;
                min-height: 100vh;
                -webkit-font-smoothing: antialiased;
            }
            a { color: inherit; text-decoration: none; }
            a:hover { text-decoration: underline; }

            /* ── Print button ──────────────────────────────── */
            .print-btn {
                position: fixed;
                top: 18px;
                right: 18px;
                z-index: 1000;
                padding: 9px 18px;
                background: linear-gradient(135deg, #2563eb, #06b6d4);
                color: white;
                border: none;
                border-radius: 10px;
                font-family: inherit;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 4px 14px rgba(37,99,235,0.45);
                transition: all 0.25s ease;
                display: flex;
                align-items: center;
                gap: 6px;
            }
            .print-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(37,99,235,0.6);
            }
            .print-btn:active { transform: translateY(0); }

            /* ── Page wrapper ──────────────────────────────── */
            .resume {
                max-width: 1020px;
                margin: 36px auto;
                background: white;
                border-radius: 18px;
                /* overflow: hidden removed — required for sticky header */
                box-shadow: 0 12px 48px rgba(0,0,0,0.15), 0 2px 8px rgba(0,0,0,0.08);
            }

            /* ── Header ────────────────────────────────────── */
            .resume-header {
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
                padding: 32px 36px;
                display: flex;
                align-items: center;
                gap: 24px;
                position: sticky;
                top: 0;
                z-index: 10;
                border-radius: 18px 18px 0 0;
                box-shadow: 0 4px 24px rgba(0,0,0,0.35);
                overflow: hidden;
            }
            /* Glow */
            .resume-header::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 55% 90% at 75% 50%, rgba(37,99,235,0.18) 0%, transparent 70%);
                pointer-events: none;
            }
            /* Rainbow accent bar */
            .resume-header::after {
                content: '';
                position: absolute;
                bottom: 0; left: 0; right: 0;
                height: 3px;
                background: linear-gradient(90deg, #2563eb 0%, #06b6d4 40%, #8b5cf6 70%, #ec4899 100%);
            }

            /* ── Avatar ─────────────────────────────────────── */
            .avatar-wrap {
                position: relative;
                flex-shrink: 0;
                width: 96px;
                height: 96px;
                z-index: 1;
                cursor: pointer;
                transition: transform 0.3s cubic-bezier(.34,1.56,.64,1), filter 0.3s ease;
            }
            .avatar-wrap::before {
                content: '';
                position: absolute;
                inset: -3px;
                border-radius: 50%;
                background: linear-gradient(135deg, #2563eb, #06b6d4, #8b5cf6);
                z-index: -1;
            }
            .avatar-wrap img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
                display: block;
                border: 3px solid #0f172a;
            }
            .eye-svg {
                position: absolute;
                top: 0; left: 0;
                width: 100%; height: 100%;
                pointer-events: none;
            }
            .avatar-wrap:hover {
                transform: scale(1.12) rotate(6deg);
                filter: drop-shadow(0 0 18px rgba(37,99,235,0.75));
            }
            .avatar-wrap.scared {
                transform: scale(0.78) translateY(12px) !important;
                filter: drop-shadow(0 0 8px rgba(239,68,68,0.6)) !important;
            }

            /* ── Header text ────────────────────────────────── */
            .header-info { flex: 1; z-index: 1; }

            .header-name {
                font-size: 21pt;
                font-weight: 800;
                color: white;
                letter-spacing: -0.5pt;
                line-height: 1.1;
                margin-bottom: 2px;
            }
            .header-nickname {
                font-size: 10pt;
                font-weight: 400;
                color: rgba(255,255,255,0.45);
                letter-spacing: 0.5pt;
            }
            .header-title {
                font-size: 10.5pt;
                font-weight: 500;
                color: #93c5fd;
                margin: 6px 0 14px;
                letter-spacing: 0.1pt;
            }
            .header-contact {
                display: flex;
                flex-wrap: wrap;
                gap: 12px 20px;
            }
            .contact-item {
                display: flex;
                align-items: center;
                gap: 5px;
                font-size: 8.5pt;
                color: rgba(255,255,255,0.65);
            }
            .contact-icon { font-size: 10px; opacity: 0.8; }
            .contact-item a { color: #93c5fd; font-weight: 500; }
            .contact-item a:hover { color: #bfdbfe; }

            /* ── Body ───────────────────────────────────────── */
            .resume-body {
                display: grid;
                grid-template-columns: 230px 1fr;
                border-radius: 0 0 18px 18px;
                overflow: hidden;
            }

            /* ── Sidebar ────────────────────────────────────── */
            .sidebar {
                background: #0f172a;
                padding: 24px 20px;
                color: rgba(255,255,255,0.82);
            }
            .sidebar-section { margin-bottom: 22px; }
            .sidebar-section:last-child { margin-bottom: 0; }

            .sidebar-title {
                font-size: 7pt;
                font-weight: 700;
                letter-spacing: 1.8pt;
                text-transform: uppercase;
                color: #60a5fa;
                margin-bottom: 10px;
                padding-bottom: 6px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            /* Skill groups */
            .skill-group { margin-bottom: 9px; }
            .skill-group:last-child { margin-bottom: 0; }
            .skill-group-label {
                font-size: 7pt;
                font-weight: 600;
                color: rgba(255,255,255,0.45);
                text-transform: uppercase;
                letter-spacing: 0.6pt;
                margin-bottom: 4px;
            }
            .skill-tags {
                display: flex;
                flex-wrap: wrap;
                gap: 3px;
            }
            .skill-tag {
                background: rgba(37,99,235,0.22);
                border: 1px solid rgba(96,165,250,0.3);
                color: rgba(255,255,255,0.8);
                padding: 2px 6px;
                border-radius: 4px;
                font-size: 7.5pt;
                line-height: 1.5;
                transition: all 0.2s ease;
            }
            .skill-tag:hover {
                background: rgba(37,99,235,0.42);
                border-color: rgba(96,165,250,0.6);
                color: white;
            }

            /* Education */
            .edu-item { margin-bottom: 6px; }
            .edu-degree {
                font-size: 8.5pt;
                font-weight: 600;
                color: white;
                line-height: 1.3;
            }
            .edu-school {
                font-size: 8pt;
                color: rgba(255,255,255,0.5);
                margin-top: 2px;
            }
            .edu-year {
                font-size: 7.5pt;
                color: #60a5fa;
                margin-top: 2px;
                font-weight: 500;
            }

            /* Certs */
            .cert-item {
                font-size: 8.5pt;
                color: rgba(255,255,255,0.8);
                padding: 6px 8px 6px 12px;
                background: rgba(255,255,255,0.04);
                border-radius: 6px;
                border-left: 2px solid #2563eb;
                line-height: 1.4;
                margin-bottom: 5px;
            }

            /* ── Main content ───────────────────────────────── */
            .main-content {
                padding: 24px 28px;
                background: white;
            }

            .main-section { margin-bottom: 18px; }
            .main-section:last-child { margin-bottom: 0; }

            .section-title {
                font-size: 7.5pt;
                font-weight: 700;
                letter-spacing: 1.5pt;
                text-transform: uppercase;
                color: #2563eb;
                margin-bottom: 10px;
                padding-bottom: 5px;
                border-bottom: 1.5px solid #e2e8f0;
                position: relative;
                transition: color 0.2s;
            }
            .section-title::after {
                content: '';
                position: absolute;
                bottom: -1.5px; left: 0;
                width: 36px; height: 1.5px;
                background: #2563eb;
                border-radius: 2px;
            }
            .section-title:hover { color: #1d4ed8; }

            /* Summary list */
            .summary-list { list-style: none; padding: 0; }
            .summary-list li {
                padding-left: 14px;
                margin-bottom: 4px;
                font-size: 9pt;
                line-height: 1.45;
                position: relative;
                color: #334155;
            }
            .summary-list li::before {
                content: '▸';
                position: absolute;
                left: 0;
                color: #2563eb;
                font-size: 8pt;
                top: 1px;
            }

            /* ── Job entry ──────────────────────────────────── */
            .job { margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #f1f5f9; }
            .job:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }

            .job-top {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 1px;
            }
            .job-company {
                font-size: 10pt;
                font-weight: 700;
                color: #0f172a;
                letter-spacing: 0.2pt;
            }
            .job-location {
                font-size: 8pt;
                color: #94a3b8;
                font-weight: 400;
            }
            .job-sub {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 6px;
            }
            .job-title-text {
                font-size: 9pt;
                font-weight: 600;
                color: #2563eb;
            }
            .job-date {
                font-size: 8pt;
                color: #64748b;
                font-style: italic;
            }
            .job-bullets { list-style: none; padding: 0; }
            .job-bullets li {
                padding-left: 13px;
                margin-bottom: 3px;
                font-size: 8.5pt;
                line-height: 1.4;
                position: relative;
                color: #334155;
                transition: transform 0.15s ease;
            }
            .job-bullets li::before {
                content: '·';
                position: absolute;
                left: 2px;
                color: #93c5fd;
                font-size: 14pt;
                line-height: 0.8;
                top: 2px;
            }
            .job-bullets li:hover { transform: translateX(3px); }

            strong { font-weight: 600; color: #0f172a; }

            /* ── Achievements grid ──────────────────────────── */
            .achievement-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 6px;
            }
            .achievement-item {
                padding: 7px 10px 7px 24px;
                background: #f8fafc;
                border-radius: 7px;
                font-size: 8.5pt;
                line-height: 1.35;
                color: #334155;
                position: relative;
                border-left: 2px solid #2563eb;
            }
            .achievement-item::before {
                content: '↑';
                position: absolute;
                left: 7px;
                top: 7px;
                color: #2563eb;
                font-weight: 700;
                font-size: 9pt;
            }

            /* ── Animations ─────────────────────────────────── */
            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(14px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .anim-in {
                opacity: 0;
                animation: fadeUp 0.45s ease forwards;
            }

            /* ── Print ──────────────────────────────────────── */
            @media print {
                body { background: white; }
                .print-btn { display: none !important; }
                .avatar-wrap { display: none !important; }
                .resume {
                    margin: 0;
                    border-radius: 0;
                    box-shadow: none;
                    max-width: 100%;
                }
                .resume-header {
                    position: static;
                    border-radius: 0;
                    box-shadow: none;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                .sidebar {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                .achievement-item {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                .job-bullets li:hover { transform: none; }
                .job { page-break-inside: avoid; }
            }

            /* ── Responsive ─────────────────────────────────── */
            @media (max-width: 720px) {
                .resume { margin: 0; border-radius: 0; }
                .resume-body { grid-template-columns: 1fr; }
                .resume-header { flex-direction: column; text-align: center; }
                .header-contact { justify-content: center; }
                .avatar-wrap { margin: 0 auto; }
                .achievement-grid { grid-template-columns: 1fr; }
                .print-btn { top: 10px; right: 10px; font-size: 11px; padding: 7px 13px; }
            }

            /* Hidden ATS keywords */
            .ats { font-size: 0; line-height: 0; color: white; visibility: collapse; user-select: none; }
        </style>
    </head>

    <body>
        <!-- Print button -->
        <button class="print-btn no-print" onclick="window.print()">
            🖨 Print / PDF
        </button>

        <div class="resume">

            <!-- ── Header ──────────────────────────────────── -->
            <header class="resume-header anim-in" style="animation-delay: 0ms;">
                <!-- Avatar with googly eyes -->
                <div class="avatar-wrap no-print" id="avatarWrap">
                    <img src="/saket-photo.jpg" alt="Saket Sharma" />
                    <svg class="eye-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                        <g transform="translate(78, 65)">
                            <ellipse cx="0" cy="0" rx="14" ry="10" fill="white" opacity="0.9" />
                            <g id="leftPupilGroup">
                                <circle cx="0" cy="0" r="7" fill="#0f172a" />
                                <circle cx="2" cy="-2" r="2" fill="white" opacity="0.85" />
                            </g>
                        </g>
                        <g transform="translate(122, 65)">
                            <ellipse cx="0" cy="0" rx="14" ry="10" fill="white" opacity="0.9" />
                            <g id="rightPupilGroup">
                                <circle cx="0" cy="0" r="7" fill="#0f172a" />
                                <circle cx="2" cy="-2" r="2" fill="white" opacity="0.85" />
                            </g>
                        </g>
                    </svg>
                </div>

                <!-- Name + contact -->
                <div class="header-info">
                    <h1 class="header-name">
                        SAKET SHARMA
                        <span class="header-nickname"> — "CLIFF WATERS"</span>
                    </h1>
                    <div class="header-title">Senior Full Stack Software Engineer · 8+ Years</div>
                    <div class="header-contact">
                        <span class="contact-item">
                            <span class="contact-icon">✉</span>
                            saket87@live.com
                        </span>
                        <span class="contact-item">
                            <span class="contact-icon">⌨</span>
                            <a href="https://github.com/doctor69" target="_blank" rel="noopener noreferrer">
                                github.com/doctor69
                            </a>
                        </span>
                        <span class="contact-item">
                            <span class="contact-icon">📍</span>
                            United States
                        </span>
                    </div>
                </div>
            </header>

            <!-- ── Body ────────────────────────────────────── -->
            <div class="resume-body">

                <!-- ── Sidebar ──────────────────────────────── -->
                <aside class="sidebar">

                    <div class="sidebar-section anim-in" style="animation-delay:80ms">
                        <div class="sidebar-title">Technical Skills</div>

                        <div class="skill-group">
                            <div class="skill-group-label">Languages</div>
                            <div class="skill-tags">
                                <span class="skill-tag">Java 8–21</span>
                                <span class="skill-tag">TypeScript</span>
                                <span class="skill-tag">JavaScript</span>
                                <span class="skill-tag">Python</span>
                                <span class="skill-tag">C#</span>
                                <span class="skill-tag">SQL / PL/SQL</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">Backend</div>
                            <div class="skill-tags">
                                <span class="skill-tag">Spring Boot 3.x</span>
                                <span class="skill-tag">Spring Cloud</span>
                                <span class="skill-tag">Spring Security</span>
                                <span class="skill-tag">Spring WebFlux</span>
                                <span class="skill-tag">Hibernate / JPA</span>
                                <span class="skill-tag">Node.js</span>
                                <span class="skill-tag">.NET Core</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">Frontend</div>
                            <div class="skill-tags">
                                <span class="skill-tag">React 18</span>
                                <span class="skill-tag">Next.js 14</span>
                                <span class="skill-tag">Redux</span>
                                <span class="skill-tag">Tailwind CSS</span>
                                <span class="skill-tag">Material-UI</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">APIs & Messaging</div>
                            <div class="skill-tags">
                                <span class="skill-tag">REST / GraphQL</span>
                                <span class="skill-tag">gRPC</span>
                                <span class="skill-tag">Apache Kafka</span>
                                <span class="skill-tag">RabbitMQ</span>
                                <span class="skill-tag">JMS / IBM MQ</span>
                                <span class="skill-tag">OAuth2 / JWT</span>
                                <span class="skill-tag">OpenAPI / Swagger</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">Databases</div>
                            <div class="skill-tags">
                                <span class="skill-tag">Oracle 19c</span>
                                <span class="skill-tag">PostgreSQL</span>
                                <span class="skill-tag">MongoDB</span>
                                <span class="skill-tag">Redis</span>
                                <span class="skill-tag">IBM DB2</span>
                                <span class="skill-tag">MySQL</span>
                                <span class="skill-tag">DynamoDB</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">Cloud & DevOps</div>
                            <div class="skill-tags">
                                <span class="skill-tag">AWS EC2/S3/Lambda</span>
                                <span class="skill-tag">AWS ECS/RDS</span>
                                <span class="skill-tag">Docker</span>
                                <span class="skill-tag">Kubernetes</span>
                                <span class="skill-tag">Terraform</span>
                                <span class="skill-tag">Jenkins</span>
                                <span class="skill-tag">GitHub Actions</span>
                            </div>
                        </div>

                        <div class="skill-group">
                            <div class="skill-group-label">Testing & Quality</div>
                            <div class="skill-tags">
                                <span class="skill-tag">JUnit 5</span>
                                <span class="skill-tag">Mockito</span>
                                <span class="skill-tag">TestContainers</span>
                                <span class="skill-tag">Jest</span>
                                <span class="skill-tag">Selenium</span>
                                <span class="skill-tag">SonarQube</span>
                            </div>
                        </div>
                    </div>

                    <div class="sidebar-section anim-in" style="animation-delay:140ms">
                        <div class="sidebar-title">Education</div>
                        <div class="edu-item">
                            <div class="edu-degree">Associate Degree<br/>Computer Science</div>
                            <div class="edu-school">Quincy College · Quincy, MA</div>
                            <div class="edu-year">2010</div>
                        </div>
                    </div>

                    <div class="sidebar-section anim-in" style="animation-delay:180ms">
                        <div class="sidebar-title">Certifications</div>
                        <div class="cert-item">FAA Certified Pilot<br/>Part 107 — UAVs</div>
                    </div>

                    <div class="sidebar-section anim-in" style="animation-delay:220ms">
                        <div class="sidebar-title">Methodologies</div>
                        <div class="skill-tags">
                            <span class="skill-tag">Agile / Scrum</span>
                            <span class="skill-tag">TDD / BDD</span>
                            <span class="skill-tag">CI/CD</span>
                            <span class="skill-tag">Microservices</span>
                            <span class="skill-tag">DDD</span>
                            <span class="skill-tag">Design Patterns</span>
                            <span class="skill-tag">SOLID</span>
                        </div>
                    </div>

                    <div class="sidebar-section anim-in" style="animation-delay:260ms">
                        <div class="sidebar-title">Tools</div>
                        <div class="skill-tags">
                            <span class="skill-tag">IntelliJ IDEA</span>
                            <span class="skill-tag">VS Code</span>
                            <span class="skill-tag">Git / GitFlow</span>
                            <span class="skill-tag">Maven / Gradle</span>
                            <span class="skill-tag">Jira / Confluence</span>
                            <span class="skill-tag">Datadog</span>
                            <span class="skill-tag">Splunk</span>
                        </div>
                    </div>

                </aside>

                <!-- ── Main content ──────────────────────────── -->
                <main class="main-content">

                    <!-- Summary -->
                    <section class="main-section anim-in" style="animation-delay:100ms">
                        <div class="section-title">Professional Summary</div>
                        <ul class="summary-list">
                            <li>Senior Software Engineer with <strong>8+ years</strong> designing enterprise applications using <strong>Java, Spring Boot, Microservices, React, and AWS</strong></li>
                            <li>Architected and delivered <strong>50+ RESTful APIs and GraphQL services</strong> handling millions of transactions with 99.9% uptime</li>
                            <li>Successfully migrated monolithic applications to containerized microservices using <strong>Docker, Kubernetes, and AWS ECS</strong> — reducing infrastructure costs by 35%</li>
                            <li>Expert in <strong>event-driven architectures</strong> with Apache Kafka, RabbitMQ, and JMS for real-time data processing at scale</li>
                            <li>Strong database design and optimization background across Oracle, PostgreSQL, DB2, MySQL, MongoDB, and Redis</li>
                            <li>Proven leadership mentoring engineering teams, conducting code reviews, and championing secure, scalable development practices</li>
                        </ul>
                    </section>

                    <!-- Experience -->
                    <section class="main-section anim-in" style="animation-delay:160ms">
                        <div class="section-title">Professional Experience</div>

                        <!-- Mastercard -->
                        <div class="job">
                            <div class="job-top">
                                <span class="job-company">MASTERCARD</span>
                                <span class="job-location">St. Louis, MO</span>
                            </div>
                            <div class="job-sub">
                                <span class="job-title-text">Senior Software Developer</span>
                                <span class="job-date">Dec 2023 – Present</span>
                            </div>
