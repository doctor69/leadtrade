                cy="100"
                rx="15"
                ry="20"
                fill="#e8b89a"
                stroke="#d4a574"
                stroke-width="2"></ellipse>
            <ellipse
                cx="170"
                cy="100"
                rx="15"
                ry="20"
                fill="#e8b89a"
                stroke="#d4a574"
                stroke-width="2"></ellipse>

            <!-- Eyebrows -->
            <path
                d="M 55 80 Q 70 75, 85 80"
                stroke="#2d2d2d"
                stroke-width="5"
                fill="none"
                stroke-linecap="round"></path>
            <path
                d="M 115 80 Q 130 75, 145 80"
                stroke="#2d2d2d"
                stroke-width="5"
                fill="none"
                stroke-linecap="round"></path>

            <!-- Eye sockets (googly eyes background) -->
            <circle
                cx="70"
                cy="95"
                r="22"
                fill="white"
                stroke="#333"
                stroke-width="3"></circle>
            <circle
                cx="130"
                cy="95"
                r="22"
                fill="white"
                stroke="#333"
                stroke-width="3"></circle>

            <!-- Pupils (will move with cursor) -->
            <circle id="leftPupil" cx="70" cy="95" r="10" fill="#1a1a1a"
