    <script is:inline>
        // Random animation assignment
        const animations = [
            "fade-in",
            "slide-in-left",
            "slide-in-right",
            "slide-in-up",
            "zoom-in",
            "bounce-in",
            "rotate-in",
        ];

        function getRandomAnimation() {
            return animations[Math.floor(Math.random() * animations.length)];
        }

        // Apply random animations to sections on page load
        document.addEventListener("DOMContentLoaded", function () {
            // Animate header
            const header = document.querySelector("h1");
            if (header) header.classList.add(getRandomAnimation());

            // Animate each h2 section with different animations
            const sections = document.querySelectorAll("h2");
            sections.forEach((section) => {
                section.classList.add(getRandomAnimation());
            });

            // Animate job sections
            const jobs = document.querySelectorAll("h3");
            jobs.forEach((job) => {
                job.classList.add(getRandomAnimation());
            });

            // Animate skill rows with staggered delay
            const skillRows = document.querySelectorAll(".skill-row");
            skillRows.forEach((row, index) => {
                setTimeout(() => {
                    row.classList.add(getRandomAnimation());
                }, index * 50);
            });
        });
    </script>

