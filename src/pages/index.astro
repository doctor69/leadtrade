---
import Layout from "../layouts/Layout.astro";
import AppShell from "@/components/AppShell";
import HomePageRedirect from "@/components/HomePageRedirect";
import { TrendingUp, Users, Trophy, BarChart3, ArrowRight, Zap, Shield, Globe } from "lucide-react";

export const prerender = true;

const pageTitle = "LEADTRADE - Professional Trading Platform with Mirror Trading";
const pageDescription = "Institutional-grade trading platform featuring real-time market data, mirror trading capabilities, and advanced performance analytics. Elevate your investment strategy with precision and confidence.";
const pageImage = "/social/leadtrade-preview.png";
const pageKeywords = "trading platform, mirror trading, stock market, investment, finance, social trading, leaderboards, real-time data, portfolio management, algorithmic trading";
---

<Layout
	title={pageTitle}
	description={pageDescription}
	image={pageImage}
	keywords={pageKeywords}
	type="website"
	url="/"
>
	<script type="application/ld+json" slot="head">
		{
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "LEADTRADE",
			"description": "Institutional-grade trading platform with real-time market data, mirror trading capabilities, and advanced analytics",
			"url": "https://leadtrade.app",
			"applicationCategory": "FinanceApplication",
			"operatingSystem": "Web Browser"
		}
	</script>

	<AppShell client:only="react">
		<HomePageRedirect client:only="react" />

		<div class="space-y-20 pb-12">

			<!-- ── Hero ──────────────────────────────────────────────── -->
			<div class="relative text-center space-y-8 pt-8 pb-4 overflow-hidden">
				<!-- Radial glow -->
				<div class="pointer-events-none absolute inset-0 -z-10">
					<div class="absolute inset-x-0 -top-24 h-[500px] bg-gradient-radial from-primary/20 via-transparent to-transparent"
						style="background: radial-gradient(ellipse 70% 60% at 50% 0%, hsl(var(--primary)/0.18) 0%, transparent 70%);">
					</div>
					<!-- Subtle grid -->
					<div class="absolute inset-0 hero-grid opacity-40"></div>
				</div>

				<!-- Badge -->
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold border"
					style="background: hsl(var(--primary)/0.1); border-color: hsl(var(--primary)/0.3); color: hsl(var(--primary));">
					<Zap class="h-3 w-3" />
					Institutional-grade trading, built for everyone
				</div>

				<!-- Headline -->
				<h1 class="text-5xl md:text-7xl font-black tracking-tight leading-[1.05]">
					<span style="background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 100% 60%)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
						LEAD
					</span><span class="text-foreground">TRADE</span>
				</h1>

				<!-- Sub-headline -->
				<p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed font-light">
					Mirror elite traders, compete on global leaderboards, and execute your
					investment strategy with real-time precision.
				</p>

				<!-- CTA buttons -->
				<div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
					<a href="/dashboard">
						<button
							class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl text-sm font-semibold text-white transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
							style="background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 100% 60%)); box-shadow: 0 4px 20px hsl(var(--primary)/0.4);"
						>
							Launch Platform
							<ArrowRight class="h-4 w-4" />
						</button>
					</a>
					<a href="/leaderboard">
						<button
							class="inline-flex items-center justify-center h-12 px-8 rounded-xl text-sm font-semibold transition-all duration-200 border hover:scale-[1.02] active:scale-[0.98]"
							style="border-color: hsl(var(--border)); color: hsl(var(--foreground)); background: hsl(var(--card));"
						>
							View Leaderboard
						</button>
					</a>
				</div>

				<!-- Trust badges -->
				<div class="flex items-center justify-center gap-6 pt-4 flex-wrap">
					<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
						<Shield class="h-3.5 w-3.5 text-success" style="color: hsl(var(--success));" />
						SEC-compliant
					</div>
					<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
						<Zap class="h-3.5 w-3.5" style="color: hsl(var(--primary));" />
						Real-time data
					</div>
					<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
						<Globe class="h-3.5 w-3.5" style="color: hsl(200 100% 60%);" />
						Global markets
					</div>
				</div>
			</div>

			<!-- ── Stats row ──────────────────────────────────────────── -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				{[
					{ label: "Active Traders", value: "10K+", color: "var(--primary)" },
					{ label: "Markets Covered", value: "50+", color: "200 100% 60%" },
					{ label: "Avg. Win Rate", value: "68%", color: "var(--success)" },
					{ label: "Daily Volume", value: "$2.4M", color: "38 92% 50%" },
				].map(stat => (
					<div
						class="rounded-2xl border p-5 text-center transition-all duration-200 hover:scale-[1.02]"
						style="background: hsl(var(--card)); border-color: hsl(var(--border));"
					>
						<div class="text-2xl md:text-3xl font-bold mb-1"
							style={`background: linear-gradient(135deg, hsl(${stat.color}), hsl(var(--primary))); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;`}
						>
							{stat.value}
						</div>
						<div class="text-xs text-muted-foreground font-medium">{stat.label}</div>
					</div>
				))}
			</div>

			<!-- ── Feature cards ──────────────────────────────────────── -->
			<div class="space-y-4">
				<div class="text-center space-y-2">
					<h2 class="text-2xl md:text-3xl font-bold tracking-tight">Everything you need to trade smarter</h2>
					<p class="text-muted-foreground max-w-xl mx-auto text-sm">
						Powerful tools built for serious traders. From real-time data to automated mirroring.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
					<!-- Feature 1 -->
					<div
						class="group rounded-2xl border p-6 space-y-4 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1"
						style="background: hsl(var(--card)); border-color: hsl(var(--border)); box-shadow: 0 2px 8px hsl(0 0% 0%/0.05);"
					>
						<div
							class="w-11 h-11 rounded-xl flex items-center justify-center"
							style="background: linear-gradient(135deg, hsl(var(--primary)/0.15), hsl(200 100% 60%/0.15));"
						>
							<TrendingUp class="h-5 w-5" style="color: hsl(var(--primary));" />
						</div>
						<div>
							<h3 class="font-semibold text-base mb-1">Real-Time Market Data</h3>
							<p class="text-sm text-muted-foreground leading-relaxed">
								Institutional-grade market data via Alpaca Markets. Execute with live pricing and intelligence.
							</p>
						</div>
						<div class="flex items-center gap-1 text-xs font-medium" style="color: hsl(var(--primary));">
							Learn more <ArrowRight class="h-3 w-3" />
						</div>
					</div>

					<!-- Feature 2 -->
					<div
						class="group rounded-2xl border p-6 space-y-4 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1"
						style="background: hsl(var(--card)); border-color: hsl(var(--border)); box-shadow: 0 2px 8px hsl(0 0% 0%/0.05);"
					>
						<div
							class="w-11 h-11 rounded-xl flex items-center justify-center"
							style="background: linear-gradient(135deg, hsl(142 76% 36%/0.15), hsl(160 80% 45%/0.15));"
						>
							<Users class="h-5 w-5" style="color: hsl(var(--success));" />
						</div>
						<div>
							<h3 class="font-semibold text-base mb-1">Mirror Trading</h3>
							<p class="text-sm text-muted-foreground leading-relaxed">
								Replicate elite trader strategies automatically. Customise allocation and risk parameters.
							</p>
						</div>
						<div class="flex items-center gap-1 text-xs font-medium" style="color: hsl(var(--success));">
							Learn more <ArrowRight class="h-3 w-3" />
						</div>
					</div>

					<!-- Feature 3 -->
					<div
						class="group rounded-2xl border p-6 space-y-4 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1"
						style="background: hsl(var(--card)); border-color: hsl(var(--border)); box-shadow: 0 2px 8px hsl(0 0% 0%/0.05);"
					>
						<div
							class="w-11 h-11 rounded-xl flex items-center justify-center"
							style="background: linear-gradient(135deg, hsl(280 65% 60%/0.15), hsl(260 70% 65%/0.15));"
						>
							<Trophy class="h-5 w-5" style="color: hsl(280 65% 60%);" />
						</div>
						<div>
							<h3 class="font-semibold text-base mb-1">Global Leaderboards</h3>
							<p class="text-sm text-muted-foreground leading-relaxed">
								Benchmark against a global trading community. Track rankings, win rates, and returns live.
							</p>
						</div>
						<div class="flex items-center gap-1 text-xs font-medium" style="color: hsl(280 65% 60%);">
							Learn more <ArrowRight class="h-3 w-3" />
						</div>
					</div>

					<!-- Feature 4 -->
					<div
						class="group rounded-2xl border p-6 space-y-4 transition-all duration-300 hover:scale-[1.02] hover:-translate-y-1"
						style="background: hsl(var(--card)); border-color: hsl(var(--border)); box-shadow: 0 2px 8px hsl(0 0% 0%/0.05);"
					>
						<div
							class="w-11 h-11 rounded-xl flex items-center justify-center"
							style="background: linear-gradient(135deg, hsl(38 92% 50%/0.15), hsl(30 90% 55%/0.15));"
						>
							<BarChart3 class="h-5 w-5" style="color: hsl(38 92% 50%);" />
						</div>
						<div>
							<h3 class="font-semibold text-base mb-1">Advanced Analytics</h3>
							<p class="text-sm text-muted-foreground leading-relaxed">
								Portfolio analytics with performance attribution, risk metrics, and trade analysis.
							</p>
						</div>
						<div class="flex items-center gap-1 text-xs font-medium" style="color: hsl(38 92% 50%);">
							Learn more <ArrowRight class="h-3 w-3" />
						</div>
					</div>
				</div>
			</div>

			<!-- ── CTA Banner ─────────────────────────────────────────── -->
			<div
				class="relative rounded-3xl overflow-hidden p-8 md:p-12 text-center space-y-6"
				style="background: linear-gradient(135deg, hsl(var(--primary)), hsl(200 100% 55%)); box-shadow: 0 8px 40px hsl(var(--primary)/0.35);"
			>
				<!-- Background pattern -->
				<div class="pointer-events-none absolute inset-0 hero-grid opacity-10"></div>

				<div class="relative space-y-4">
					<h2 class="text-2xl md:text-4xl font-bold text-white tracking-tight">
						Ready to trade like the best?
					</h2>
					<p class="text-white/80 max-w-md mx-auto text-sm md:text-base">
						Join thousands of traders already using LEADTRADE to grow their portfolios.
					</p>
					<div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
						<a href="/signup">
							<button
								class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl text-sm font-semibold transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]"
								style="background: white; color: hsl(var(--primary));"
							>
								Get Started Free
								<ArrowRight class="h-4 w-4" />
							</button>
						</a>
						<a href="/leaderboard">
							<button
								class="inline-flex items-center justify-center h-12 px-8 rounded-xl text-sm font-semibold transition-all duration-200 hover:scale-[1.02] border border-white/30 text-white hover:bg-white/10"
							>
								Browse Leaderboard
							</button>
						</a>
					</div>
				</div>
			</div>

		</div>
	</AppShell>
</Layout>
