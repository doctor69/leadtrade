---
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";
import AppShell from "@/components/AppShell";
import HomePageRedirect from "@/components/HomePageRedirect";
import { TrendingUp, Users, Trophy, BarChart3 } from "lucide-react";

// Enable prerendering for static generation
export const prerender = true;

// Remove server-side cookie access for static generation
// Authentication will be handled client-side
let loggedIn = false;

// Define critical resources to preload
const preloadResources = [
	"/favicon.svg",
	// Add other critical resources as needed
];

// Social media metadata for homepage
const pageTitle = "LEADTRADE - Professional Trading Platform with Mirror Trading";
const pageDescription = "Institutional-grade trading platform featuring real-time market data, mirror trading capabilities, and advanced performance analytics. Elevate your investment strategy with precision and confidence.";
const pageImage = "/social/leadtrade-preview.png";
const pageKeywords = "trading platform, mirror trading, stock market, investment, finance, social trading, leaderboards, real-time data, portfolio management, algorithmic trading";
---

<Layout 
	title={pageTitle}
	description={pageDescription}
	image={pageImage}
	keywords={pageKeywords}
	type="website"
	url="/"
>
	<!-- Structured Data for better social sharing -->
	<script type="application/ld+json" slot="head">
		{
			"@context": "https://schema.org",
			"@type": "WebApplication",
			"name": "LEADTRADE",
			"description": "Institutional-grade trading platform with real-time market data, mirror trading capabilities, and advanced analytics",
			"url": "https://leadtrade.app",
			"applicationCategory": "FinanceApplication",
			"operatingSystem": "Web Browser",
			"featureList": [
				"Real-time market data",
				"Mirror trading capabilities",
				"Competitive leaderboards",
				"Advanced portfolio analytics",
				"Performance tracking",
				"Risk management tools",
				"Algorithmic trading support"
			],
			"screenshot": "https://leadtrade.app/social/leadtrade-preview.svg",
			"author": {
				"@type": "Organization",
				"name": "LEADTRADE Team"
			}
		}
	</script>
<AppShell client:only="react">
	<HomePageRedirect client:only="react" />
	<div class="space-y-12">
		<!-- Hero Section -->
		<div class="text-center space-y-6">
			<h1 class="text-4xl md:text-6xl font-bold text-foreground">
				<span class="text-primary">LEAD</span>TRADE
			</h1>
			<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
				Institutional-grade trading platform with real-time market intelligence. Mirror elite traders, compete on global leaderboards, and execute your investment strategy with precision.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/dashboard">
					<Button size="lg" className="w-full sm:w-auto">
						Launch Platform
					</Button>
				</a>
				<a href="/leaderboard">
					<Button variant="outline" size="lg" className="w-full sm:w-auto">
						View Leaderboard
					</Button>
				</a>
			</div>
		</div>

		<!-- Features Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			<Card className="text-center">
				<CardHeader>
					<div class="mx-auto w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4">
						<TrendingUp className="h-6 w-6 text-blue-600 dark:text-blue-400" />
					</div>
					<CardTitle>Real-Time Market Data</CardTitle>
				</CardHeader>
				<CardContent>
					<CardDescription>
						Access institutional-grade market data powered by Alpaca Markets. Execute trades with real-time pricing and market intelligence.
					</CardDescription>
				</CardContent>
			</Card>

			<Card className="text-center">
				<CardHeader>
					<div class="mx-auto w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center mb-4">
						<Users className="h-6 w-6 text-green-600 dark:text-green-400" />
					</div>
					<CardTitle>Mirror Trading</CardTitle>
				</CardHeader>
				<CardContent>
					<CardDescription>
						Replicate the strategies of elite traders automatically. Customize allocation percentages and risk parameters to align with your investment objectives.
					</CardDescription>
				</CardContent>
			</Card>

			<Card className="text-center">
				<CardHeader>
					<div class="mx-auto w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mb-4">
						<Trophy className="h-6 w-6 text-purple-600 dark:text-purple-400" />
					</div>
					<CardTitle>Global Leaderboards</CardTitle>
				</CardHeader>
				<CardContent>
					<CardDescription>
						Benchmark your performance against a global community of traders. Track rankings, win rates, and portfolio returns in real-time.
					</CardDescription>
				</CardContent>
			</Card>

			<Card className="text-center">
				<CardHeader>
					<div class="mx-auto w-12 h-12 bg-orange-100 dark:bg-orange-900 rounded-lg flex items-center justify-center mb-4">
						<BarChart3 className="h-6 w-6 text-orange-600 dark:text-orange-400" />
					</div>
					<CardTitle>Advanced Analytics</CardTitle>
				</CardHeader>
				<CardContent>
					<CardDescription>
						Comprehensive portfolio analytics with performance attribution, risk metrics, and trade analysis to optimize your strategy.
					</CardDescription>
				</CardContent>
			</Card>
		</div>

		<!-- CTA Section -->
		<Card className="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-950 dark:to-purple-950 border-none">
			<CardContent className="p-8 text-center">
				<h2 class="text-2xl font-bold mb-4">Begin Your Trading Journey</h2>
				<p class="text-muted-foreground mb-6 max-w-2xl mx-auto">
					Join an elite community of traders utilizing institutional-grade market data, sophisticated analytics, and mirror trading technology to achieve superior investment outcomes.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/signup">
						<Button size="lg" className="w-full sm:w-auto">
							Create Account
						</Button>
					</a>
					<a href="/signin">
						<Button variant="outline" size="lg" className="w-full sm:w-auto">
							Sign In
						</Button>
					</a>
				</div>
			</CardContent>
		</Card>
	</div>
</AppShell>
</Layout>