# Alpaca API Configuration - Paper Trading (Sandbox)
PUBLIC_ALPACA_PAPER_BROKER_API_KEY=your_paper_alpaca_api_key_here
PUBLIC_ALPACA_PAPER_BROKER_API_SECRET=your_paper_alpaca_api_secret_here
PUBLIC_ALPACA_PAPER_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets/v1
PUBLIC_ALPACA_PAPER_DATA_API_KEY=your_paper_alpaca_data_api_key_here
PUBLIC_ALPACA_PAPER_DATA_API_SECRET=your_paper_alpaca_data_api_secret_here
PUBLIC_ALPACA_PAPER_DATA_BASE_URL=https://data.sandbox.alpaca.markets
PUBLIC_ALPACA_PAPER_WS_URL=wss://stream.data.sandbox.alpaca.markets/v2

# Alpaca API Configuration - Live Trading (Production)
PUBLIC_ALPACA_LIVE_BROKER_API_KEY=your_live_alpaca_api_key_here
PUBLIC_ALPACA_LIVE_BROKER_API_SECRET=your_live_alpaca_api_secret_here
PUBLIC_ALPACA_LIVE_BROKER_BASE_URL=https://broker-api.alpaca.markets/v1
PUBLIC_ALPACA_LIVE_DATA_API_KEY=your_live_alpaca_data_api_key_here
PUBLIC_ALPACA_LIVE_DATA_API_SECRET=your_live_alpaca_data_api_secret_here
PUBLIC_ALPACA_LIVE_DATA_BASE_URL=https://data.alpaca.markets
PUBLIC_ALPACA_LIVE_WS_URL=wss://stream.data.alpaca.markets/v2

# Note: For WebSocket real-time data, you need separate Data API keys from Alpaca
# These are different from the Broker API keys above

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
PUBLIC_APP_URL=http://localhost:4321
NODE_ENV=development