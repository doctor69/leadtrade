# Alpaca API Configuration (Sandbox)
PUBLIC_ALPACA_BROKER_SANDBOX_API_KEY=your_alpaca_api_key_here
PUBLIC_ALPACA_BROKER_SANDBOX_API_SECRET=your_alpaca_api_secret_here
PUBLIC_ALPACA_BROKER_SANDBOX_BASE_URL=https://broker-api.sandbox.alpaca.markets/v1

# Alpaca Data API (if needed)
PUBLIC_ALPACA_DATA_API_KEY=your_alpaca_data_api_key_here
PUBLIC_ALPACA_DATA_API_SECRET=your_alpaca_data_api_secret_here
PUBLIC_ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Application Configuration
PUBLIC_APP_URL=http://localhost:4321
NODE_ENV=development