{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Listens to TypeScript source files, Astro components, configuration files, and other relevant project files. When changes are detected, automatically updates the README.md with current project information and structure.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.astro",
      "*.ts",
      "*.mjs",
      "*.json",
      "package.json",
      "astro.config.mjs",
      "tailwind.config.ts",
      "tsconfig.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code files have been modified in this Astro/TypeScript project. Please analyze the changes and update the README.md file to reflect the current project structure, features, components, and API endpoints. Focus on documenting new components, trading features, API routes, and any architectural changes. Ensure the documentation accurately represents the current state of the codebase."
  }
}